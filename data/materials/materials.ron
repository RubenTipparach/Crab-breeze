// Every Material Maker material Crab Breeze ships (openspec changes `blast-scorch` and `fx-sprites`). Each is rendered from
// `tools/materials/ptex/<name>.ptex` by `tools/materials/export_materials.sh` and written by `tools/materials/postprocess.py`
// to `assets/textures/fx/<name>/`. `size_px` is the shipped size; `maps` the maps shipped; `use` what reads it.
// The houses' surface sets (rows with a `dir`): one per generator of the small-buildings kit's SURFACES table, written by
// `tools/materials/build_house_ptex.py`, rendered by `tools/materials/export_house_materials.sh` and written by
// `postprocess.py --houses` to `assets/textures/<dir>/`. `tile_m` is the metres one tile covers (the kit's UVs are metres),
// `surfaces` the kit's keys drawn with the set, `roughness` and `metallic` the set's mean ORM green and blue (0..1), so a
// surface whose own roughness or metal differs from its set's can scale the map by its value over these.
(
    materials: [
        (name: "blast_scorch", size_px: 2048, maps: ["albedo", "normal", "orm"], use: "decal over a crater on soil"),
        (name: "churned_soil", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 2.0, use: "the crater's bowl"),
        (name: "smoke_puffs", size_px: 1024, maps: ["albedo"], grid: 4, use: "smoke, steam and trail particles"),
        (name: "fire_flipbook", size_px: 1024, maps: ["albedo"], grid: 4, use: "fire and flame particles, played over life"),
        (name: "dust_wisps", size_px: 1024, maps: ["albedo"], grid: 4, use: "dust particles"),
        (name: "hit_marks", size_px: 1024, maps: ["albedo", "normal", "orm"], grid: 4, use: "hit-mark decals on mech armour"),
        (name: "dirt_clods", size_px: 1024, maps: ["albedo"], grid: 4, use: "dirt, debris and rubble particles"),
        (name: "house_brick", dir: "houses/brick", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 0.9, roughness: ROUGH_brick, metallic: METAL_brick, surfaces: ["brick"], use: "face brick, 215 x 65 mm in running bond with 10 mm joints"),
        (name: "house_block", dir: "houses/block", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 0.8, roughness: ROUGH_block, metallic: METAL_block, surfaces: ["block"], use: "concrete block, 390 x 190 mm in running bond"),
        (name: "house_siding", dir: "houses/siding", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_siding, metallic: METAL_siding, surfaces: ["siding"], use: "painted clapboard lap siding, 167 mm exposure"),
        (name: "house_board", dir: "houses/board", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_board, metallic: METAL_board, surfaces: ["board"], use: "board and batten, 333 mm boards and 64 mm battens"),
        (name: "house_stucco", dir: "houses/stucco", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 2.0, roughness: ROUGH_stucco, metallic: METAL_stucco, surfaces: ["stucco"], use: "knockdown sand-float stucco"),
        (name: "house_adobe", dir: "houses/adobe", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 2.5, roughness: ROUGH_adobe, metallic: METAL_adobe, surfaces: ["adobe"], use: "mud plaster over adobe brick courses"),
        (name: "house_shingle", dir: "houses/shingle", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_shingle, metallic: METAL_shingle, surfaces: ["shingle"], use: "three-tab asphalt shingles, 125 mm courses"),
        (name: "house_tile", dir: "houses/tile", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_tile, metallic: METAL_tile, surfaces: ["tile"], use: "clay barrel roof tiles, 250 x 333 mm"),
        (name: "house_metalRoof", dir: "houses/metalRoof", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_metalRoof, metallic: METAL_metalRoof, surfaces: ["metalRoof"], use: "standing-seam steel roof, 500 mm panels"),
        (name: "house_corrugated", dir: "houses/corrugated", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_corrugated, metallic: METAL_corrugated, surfaces: ["corrugated", "corrugatedArc"], use: "galvanised corrugated sheet, 77 mm pitch"),
        (name: "house_ribbed", dir: "houses/ribbed", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_ribbed, metallic: METAL_ribbed, surfaces: ["ribbed"], use: "ribbed aluminium siding, 167 mm ribs"),
        (name: "house_skirt", dir: "houses/skirt", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_skirt, metallic: METAL_skirt, surfaces: ["skirt"], use: "vinyl skirting, 125 mm panels"),
        (name: "house_concrete", dir: "houses/concrete", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 2.0, roughness: ROUGH_concrete, metallic: METAL_concrete, surfaces: ["concrete"], use: "cast concrete"),
        (name: "house_roofing", dir: "houses/roofing", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_roofing, metallic: METAL_roofing, surfaces: ["roofing"], use: "gravel-surfaced built-up flat roof"),
        (name: "house_asphalt", dir: "houses/asphalt", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 2.0, roughness: ROUGH_asphalt, metallic: METAL_asphalt, surfaces: ["asphalt"], use: "asphalt paving"),
        (name: "house_smooth", dir: "houses/smooth", size_px: 512, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_smooth, metallic: METAL_smooth, surfaces: ["trim", "paint", "soffit", "plaster", "metal", "product", "rubber", "paintCar"], use: "smooth paint, faint stipple"),
        (name: "house_shutter", dir: "houses/shutter", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 0.5, roughness: ROUGH_shutter, metallic: METAL_shutter, surfaces: ["shutter"], use: "louvred shutter slats, 42 mm"),
        (name: "house_door", dir: "houses/door", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_door, metallic: METAL_door, surfaces: ["door"], use: "painted V-groove door boards, 125 mm"),
        (name: "house_brushed", dir: "houses/brushed", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_brushed, metallic: METAL_brushed, surfaces: ["stainless"], use: "brushed stainless steel"),
        (name: "house_laminate", dir: "houses/laminate", size_px: 512, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_laminate, metallic: METAL_laminate, surfaces: ["counter"], use: "flecked plastic laminate countertop"),
        (name: "house_wood", dir: "houses/wood", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_wood, metallic: METAL_wood, surfaces: ["wood"], use: "bare timber, flat-sawn grain"),
        (name: "house_planks", dir: "houses/planks", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_planks, metallic: METAL_planks, surfaces: ["deck", "floorWood"], use: "deck and floor planks, 143 mm with 5 mm gaps"),
        (name: "house_pine", dir: "houses/pine", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_pine, metallic: METAL_pine, surfaces: ["woodInt"], use: "knotty pine panelling, 167 mm boards"),
        (name: "house_floorTile", dir: "houses/floorTile", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 0.9, roughness: ROUGH_floorTile, metallic: METAL_floorTile, surfaces: ["floorTile"], use: "black and white checker floor tiles, 450 mm"),
        (name: "house_wallTile", dir: "houses/wallTile", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_wallTile, metallic: METAL_wallTile, surfaces: ["tileWall", "tileRed"], use: "glazed wall tiles, 111 mm"),
        (name: "house_carpet", dir: "houses/carpet", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 1.0, roughness: ROUGH_carpet, metallic: METAL_carpet, surfaces: ["carpet"], use: "cut-pile carpet"),
        (name: "house_fabric", dir: "houses/fabric", size_px: 1024, maps: ["albedo", "normal", "orm"], tile_m: 0.5, roughness: ROUGH_fabric, metallic: METAL_fabric, surfaces: ["fabric"], use: "plain-weave upholstery cloth, 2 mm threads"),
    ],
)
