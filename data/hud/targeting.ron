// Targeting and missile lock (openspec/changes/targeting), after Ace Combat: every enemy within
// `max_range_m` is boxed; the one nearest the crosshair (within `pick_cone_deg`) or picked with Q is
// selected; it locks after `lock_s` inside `lock_range_m` (missile range) and `lock_cone_deg`.
// A civil aircraft (civil-air-traffic) is boxed but never selected or locked (owner, 2026-10-26, survey W47).
(
    max_range_m: 2000.0,
    pick_cone_deg: 30.0,
    lock_range_m: 1200.0,
    lock_cone_deg: 12.0,
    lock_s: 1.0,
    box_px: (18.0, 160.0),
    // Fog hides targets (owner, 2026-10-26, survey F2: "Approve all"). Along the line from the eye to
    // a target, while 60 % or more of its light gets through the fog, nothing changes; below that the
    // boxing and lock ranges shrink in step, to a quarter when none gets through, and a lock builds
    // as much slower. The fog is the one the screens draw (data/world/world.ron, fog:).
    fog_clear_share: 0.6,
    fog_min_scale: 0.25,
    // Q (owner, 2026-10-29: "cool down 15 seconds for objects close to q"): the enemy nearest the crosshair within
    // pick_cone_deg it has not picked in the last 15 s; with all of those picked, the rest by priority then distance;
    // with those used up too, the nearest the crosshair again.
    cycle_cooldown_s: 15.0,
)
