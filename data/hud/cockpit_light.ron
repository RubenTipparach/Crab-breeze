// The sealed cockpit's own light (openspec/changes/cockpit-lighting): its lamps and its screens,
// never the sun or a flash outside. Screen positions are from the pilot's eye: x right, y up,
// z back (so -1.2 is 1.2 m ahead).
(
    cabin_ambient_colour: (0.9, 0.82, 0.72),
    cabin_ambient_cd_m2: 120.0,
    screen_lumens: 200.0,
    screen_range_m: 4.0,
    screen_tint: (0.75, 0.88, 1.0),
    screens_m: [(0.0, 0.0, -1.2), (-1.0, 0.0, -0.6), (1.0, 0.0, -0.6)],
    // The screens' cube map (task 2.1): the world drawn round the eye, one face a frame, filtered
    // into the cabin's light. 0 px turns it off.
    // Owner, 2026-10-24: "Cube map should update like 10fps". Measured uncapped on the RTX 3070,
    // CPU-bound: a face every frame cost 4.7 ms; at 10 refreshes a second with 3 km faces 7-9 ms
    // (each face visits every mesh in the world); with 400 m faces still 3-8 ms in the fight. Off
    // (0 px) until the cheaper route: the screens' average colours from the frame already drawn.
    screens_cube_px: 0,
    screens_cube_cd_m2: 400.0,
    screens_cube_hz: 10.0,
)
