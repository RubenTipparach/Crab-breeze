// Device bindings for the input actions (openspec/changes/pilot-boarding/design.md section 1).
// Key names are Bevy KeyCode names (KeyW, ShiftLeft, ...). The scripted pilot writes the same
// actions without going through these.
(
    mouse_deg_per_px: 0.1,
    invert_pitch: false,
    forward: ["KeyW"],
    back: ["KeyS"],
    left: ["KeyA"],
    right: ["KeyD"],
    run: ["ShiftLeft"],
    use_key: ["KeyE"],
    // Held: look round the cockpit uncoupled from the mech's nose, and press MFDs (owner,
    // 2026-10-24: "holding ctrl should let you free look").
    free_look: ["ControlLeft"],
    throttle_zero: ["KeyX"],
    mode_walk: ["Digit1"],
    mode_skate: ["Digit2"],
    mode_jet: ["Digit3"],
    release_mouse: ["Escape"],
    lift: ["Space"],
    // Test keys until weapons exist.
    debug_hit_arm_l: ["F5"],
    debug_hit_arm_r: ["F6"],
    debug_hit_head: ["F7"],
    debug_hit_leg_l: ["F8"],
    debug_shell: ["F9"],
    fire_primary: ["MouseLeft"],
    fire_secondary: ["MouseRight"],
    // In the mech (openspec boost-and-skate, water-skimming): Space lifts on the rockets (up only),
    // Shift toggles the skates (all paid horizontal movement: wheels on the ground and the water,
    // WASD thrust in the air), C dives from the air or sinks on water (Ctrl is free look).
    skate: ["ShiftLeft"],
    sink: ["KeyC"],
    // Targeting (openspec targeting): F fires a missile at the lock, Q selects the next target.
    fire_missile: ["KeyF"],
    target_next: ["KeyQ"],
    // Close combat (openspec close-combat): on by itself when the targeted hostile is within melee
    // range, off when it goes down or moves away; Tab switches it off, or on with no one near.
    // In close combat the mouse buttons strike with the arms and the guns hold.
    close_combat: ["Tab"],
    // The selected weapon station, which the left mouse fires (weapon-select; owner, 2026-10-25: "can
    // scroll wheel change weaopon selection?"): the wheel steps it, down on and up back; ] steps on.
    weapon_cycle: ["MouseWheel", "BracketRight"],
    // The mail: a career's job offers (mission-jobs; owner, survey J1: "press M to focus on the mail screen"), free
    // roam's missions (free-roam-missions).
    mail: ["KeyM"],
    // Punches in close combat, on their own keys so the guns keep firing (owner, 2026-10-25, picking
    // "Guns keep firing in close combat, and punches move to other keys").
    strike_left: ["KeyZ"],
    strike_right: ["KeyV"],
)
