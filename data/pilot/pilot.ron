    walk_speed_m_s: 1.6,
    run_speed_m_s: 4.5,
    accel_m_s2: 12.0,
    eye_height_m: 1.7,
    body_radius_m: 0.35,
    pitch_limit_deg: 85.0,
    board_reach_m: 3.0,
    lift_speed_m_s: 2.0,
    free_look_yaw_deg: 120.0,
    free_look_pitch_deg: 70.0,
    free_look_return_deg_s: 180.0,
)
