// The pilot on foot and boarding. Game speeds, not a stroll (owner, 2026-10-24: "slow and
// sluggish"): walk 4 m/s, run 7.5 m/s, at full speed in a sixth of a second.
// (openspec/changes/pilot-boarding/design.md). Units in the keys.
(
    walk_speed_m_s: 4.0,
    run_speed_m_s: 7.5,
    accel_m_s2: 30.0,
    eye_height_m: 1.7,
    body_radius_m: 0.35,
    pitch_limit_deg: 85.0,
    max_wade_depth_m: 1.2,
    board_reach_m: 25.0,
    climb_speed_m_s: 7.0,
    // Seated, the view stays within 90 degrees of the mech's nose; past it the mech turns at its own
    // rate. Free look (held) is unlimited (openspec/changes/seated-look; owner, 2026-10-24).
    seated_look_limit_deg: 90.0,
    // Vertical field of view seated in the cockpit (the Options page's setting starts here): 85 degrees is about 117 across a 16:9 screen (owner, 2026-10-24:
    // "Wider fov?"; was 75, about 107 across). 95 is about 125 across (owner, 2026-10-25: "can you increase
    // player fov a bit", "95?"; was 85, about 117).
    view_fov_deg: 95.0,
    // On foot the view is a first-person shooter's 75 degrees, about 107 across, and widens to the seated view as
    // the pilot sits, narrowing again as they stand, over 0.8 s (owner, 2026-10-26: "normal fps fov is 75, it grows
    // to 95 when inside the mech"; openspec/changes/seated-fov). The Options setting moves both.
    on_foot_fov_deg: 75.0,
    // Both are measured ACROSS the screen (survey V1, the owner's pick, 2026-10-28; asked 2026-10-26: "is my fps fov
    // still 75? it seems kinda wide"): on foot 75 across, about 47 tall on 16:9 (it was 75 tall, about 107 across),
    // the cockpit 95 across, about 63 tall (it was 95 tall, about 125 across). Driving a car uses the on-foot view
    // ("car driving should remain at 75"). The Options setting is the cockpit's, across.
    fov_across: true,
    fov_change_s: 0.8,
    // On foot, Space jumps: 4.4 m/s up under 9.81 m/s2 is a jump about a metre high (owner,
    // 2026-10-25: "my fps character needs jump!").
    jump_speed_m_s: 4.4,
    gravity_m_s2: 9.81,
    // Cars (openspec/changes/car-driving): Use within 1.2 m of the driver's door, facing the car;
    // the eyes are carried between the door and the seat over 0.8 s; below 0.5 m/s a car is stopped.
    car_reach_m: 1.2,
    car_step_s: 0.8,
    car_face_deg: 75.0,
    car_stopped_m_s: 0.5,
    // Driving a car is third person, the one exception to THE LAW (owner, 2026-10-26: "also driving should be in 3rd
    // person"; openspec/changes/car-chase-camera). The camera orbits a point over the car's roof, as far back as
    // distance_m plus distance_per_length times the car's length (a sedan 8.1 m, the bus 16.9 m), looking down
    // rest_pitch_deg with the mouse's pitch at zero. The mouse orbits it all the way round; with the mouse still
    // recenter_after_s and the car faster than recenter_min_speed_m_s it drifts back behind the car at
    // recenter_deg_s (provisional). It pulls in short of buildings and the ground, and eases out of the pilot's eyes
    // on getting in and back into them on getting out over blend_s. Its field of view stays the on-foot one.
    car_camera: (
        distance_m: 2.5,
        distance_per_length: 1.2,
        pivot_above_roof_m: 0.6,
        rest_pitch_deg: -12.0,
        pitch_range_deg: (-60.0, 30.0),
        follow_lag_s: 0.08,
        heading_lag_s: 0.25,
        recenter_after_s: 2.0,
        recenter_deg_s: 90.0,
        recenter_min_speed_m_s: 2.0,
        clip_margin_m: 0.4,
        min_distance_m: 1.5,
        blend_s: 0.6,
    ),
)
