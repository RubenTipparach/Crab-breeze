// Breeze's boarding sequence (openspec/changes/mech-boarding/design.md sections 2 and 3, the
// mockup's first draft). Times are on one timeline: 0 standing and sealed, `ready_s` sat with the
// hatch open. Closing plays it backwards. Each motion turns a node about its own origin (the
// hinge) on `axis` in the node's own frame, and slides it by `translate_m` in that frame. A
// trailing `*` matches every node with that prefix, in name order, `stagger_s` apart.
(
    sit: (duration_s: 3.5, pelvis_height_m: 1.4, hock_angle_deg: 90.0, torso_bow_deg: 20.0),
    stages: [
        (name: "latches release", start_s: 3.6, duration_s: 0.4,
            motions: [(node: "LATCH_*", translate_m: (0.0, 0.0, -0.04))],
            vents: [(node: "VENT_latch*", kind: Steam, duration_s: 0.4, rate_per_s: 80.0, speed_m_s: 2.5)]),
        (name: "pressure equalises", start_s: 4.2, duration_s: 0.4,
            vents: [
                (node: "VENT_seam*", kind: Steam, duration_s: 0.8, rate_per_s: 120.0, speed_m_s: 3.5),
                (node: "VENT_seam*", kind: Mist, duration_s: 10.0, rate_per_s: 30.0, speed_m_s: 0.4),
            ]),
        (name: "visor lifts", start_s: 4.6, duration_s: 0.8,
            motions: [(node: "HATCH_upper", axis: (1.0, 0.0, 0.0), angle_deg: -80.0)],
            vents: [(node: "VENT_hinge*", kind: Steam, duration_s: 0.5, rate_per_s: 90.0, speed_m_s: 3.0)]),
        (name: "flaps swing out", start_s: 5.0, duration_s: 0.7,
            motions: [
                (node: "FLAP_L", axis: (0.0, 1.0, 0.0), angle_deg: 70.0),
                (node: "FLAP_R", axis: (0.0, 1.0, 0.0), angle_deg: -70.0),
            ],
            vents: [(node: "VENT_side*", kind: Steam, duration_s: 0.4, rate_per_s: 120.0, speed_m_s: 4.0)]),
        (name: "lower plate drops", start_s: 5.4, duration_s: 0.8,
            motions: [(node: "HATCH_lower", axis: (1.0, 0.0, 0.0), angle_deg: 100.0)]),
        (name: "shutters retract", start_s: 5.8, duration_s: 0.3,
            motions: [(node: "SHUTTER_*", translate_m: (0.0, 0.5, 0.0), stagger_s: 0.15)],
            vents: [(node: "VENT_cabin*", kind: Mist, duration_s: 8.0, rate_per_s: 60.0, speed_m_s: 0.6)]),
        (name: "stair unfolds", start_s: 6.6, duration_s: 0.6,
            motions: [(node: "STEP_*", axis: (1.0, 0.0, 0.0), angle_deg: 90.0, stagger_s: 0.1)]),
        (name: "console clears", start_s: 7.2, duration_s: 0.8,
            motions: [(node: "CONSOLE_front", axis: (1.0, 0.0, 0.0), angle_deg: -55.0)]),
    ],
    ready_s: 8.0,
    clear_m: 3.0,
    screen_power_up_s: 2.5,
    screen_power_down_s: 0.6,
)
