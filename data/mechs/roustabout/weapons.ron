(
    weapons: [
        (name: "breaching gun", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 550.0, interval_s: 1.2,
         penetration_mm: 45.0, damage: 8.0, blast_mj: 0.0, kind: Pellets(count: 16, spread_deg: 2.0), signature: true),
        (name: "35 mm autocannon", socket: "MUZZLE_L", arm: ArmL, group: 1, speed_m_s: 1100.0, interval_s: 0.12,
