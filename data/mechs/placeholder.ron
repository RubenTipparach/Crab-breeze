// The stand-in mech (openspec/changes/mech-rig/design.md section 5), built from boxes on the exact
// bones of docs/design/mech-rig.md. Offsets are from the parent, in glTF space: +y up, +z forward,
// +x the mech's own left. 12 m to the top of the torso, eyes at 9.6 m.
//
// To fly a Blender mech instead, set `model: Some("models/mech_<name>.glb")`: the same code binds
// and drives it by bone name, and these nodes and boxes are then unused.
(
    name: "stand-in",
    model: None,
    locomotion: (
        walk_speed_max_m_s: 7.0,
        throttle_min: -0.4,
        throttle_rate_per_s: 0.6,
        accel_m_s2: 2.5,
        brake_m_s2: 4.0,
        turn_rate_deg_s: 30.0,
        twist_max_deg: 100.0,
        twist_rate_deg_s: 70.0,
        pitch_limits_deg: (-20.0, 25.0),
        pitch_rate_deg_s: 40.0,
        body_radius_m: 3.0,
        stopped_speed_m_s: 0.2,
    ),
    gait: (
        stride_max_m: 9.0,
        stride_min_m: 2.0,
        step_height_m: 0.9,
        bob_m: 0.25,
        sway_m: 0.15,
        turn_step_radius_m: 2.5,
        settle_speed_m_s: 0.6,
    ),
    nodes: [
        (name: "root", offset_m: (0.0, 0.0, 0.0)),
        (name: "pelvis", parent: "root", offset_m: (0.0, 6.2, 0.0)),
        (name: "torso_twist", parent: "pelvis", offset_m: (0.0, 0.8, 0.0)),
        (name: "torso", parent: "torso_twist", offset_m: (0.0, 0.6, 0.0)),
        (name: "cockpit", parent: "torso", offset_m: (0.0, 1.6, 1.4)),
        (name: "EYE_pilot", parent: "cockpit", offset_m: (0.0, 0.4, 0.6)),
        (name: "SEAT_pilot", parent: "cockpit", offset_m: (0.0, -0.3, 0.3)),
        (name: "HATCH_entry", parent: "cockpit", offset_m: (0.0, 1.4, 0.0)),
        (name: "LADDER_base", parent: "root", offset_m: (0.0, 0.0, -3.8)),

        (name: "shoulder_L", parent: "torso", offset_m: (3.0, 3.4, -0.6)),
        (name: "upper_arm_L", parent: "shoulder_L", offset_m: (0.5, 0.0, 0.0)),
        (name: "forearm_L", parent: "upper_arm_L", offset_m: (0.0, -2.4, 0.0)),
        (name: "hand_L", parent: "forearm_L", offset_m: (0.0, 0.0, 2.2)),
        (name: "MUZZLE_L", parent: "hand_L", offset_m: (0.0, 0.0, 1.2)),
        (name: "shoulder_R", parent: "torso", offset_m: (-3.0, 3.4, -0.6)),
        (name: "upper_arm_R", parent: "shoulder_R", offset_m: (-0.5, 0.0, 0.0)),
        (name: "forearm_R", parent: "upper_arm_R", offset_m: (0.0, -2.4, 0.0)),
        (name: "hand_R", parent: "forearm_R", offset_m: (0.0, 0.0, 2.2)),
        (name: "MUZZLE_R", parent: "hand_R", offset_m: (0.0, 0.0, 1.2)),
        (name: "JET_L", parent: "torso", offset_m: (1.6, 2.6, -3.1)),
        (name: "JET_R", parent: "torso", offset_m: (-1.6, 2.6, -3.1)),

        (name: "thigh_L", parent: "pelvis", offset_m: (1.6, -0.3, 0.0)),
        (name: "shin_L", parent: "thigh_L", offset_m: (0.0, -2.4, 1.4)),
        (name: "hock_L", parent: "shin_L", offset_m: (0.0, -1.9, -1.8)),
        (name: "foot_L", parent: "hock_L", offset_m: (0.0, -1.1, 0.3)),
        (name: "toe_L", parent: "foot_L", offset_m: (0.0, -0.3, 1.1)),
        (name: "WHEEL_L", parent: "foot_L", offset_m: (0.0, -0.2, 0.2)),
        (name: "thigh_R", parent: "pelvis", offset_m: (-1.6, -0.3, 0.0)),
        (name: "shin_R", parent: "thigh_R", offset_m: (0.0, -2.4, 1.4)),
        (name: "hock_R", parent: "shin_R", offset_m: (0.0, -1.9, -1.8)),
        (name: "foot_R", parent: "hock_R", offset_m: (0.0, -1.1, 0.3)),
        (name: "toe_R", parent: "foot_R", offset_m: (0.0, -0.3, 1.1)),
        (name: "WHEEL_R", parent: "foot_R", offset_m: (0.0, -0.2, 0.2)),
    ],
    // Tones: 0 hull, 1 dark, 2 joint, 3 cockpit frame, 5 accent.
    boxes: [
        (bone: "root", centre_m: (1.1, 6.0, -3.8), size_m: (0.3, 12.0, 0.3), tone: 1),
        (bone: "root", centre_m: (-1.1, 6.0, -3.8), size_m: (0.3, 12.0, 0.3), tone: 1),
        (bone: "pelvis", centre_m: (0.0, 0.0, 0.0), size_m: (3.6, 1.2, 2.2), tone: 1),
        (bone: "torso_twist", centre_m: (0.0, 0.2, 0.0), size_m: (2.0, 0.8, 2.0), tone: 2),
        (bone: "torso", centre_m: (0.0, 2.2, -0.9), size_m: (5.0, 4.4, 3.6), tone: 0),
        (bone: "torso", centre_m: (1.6, 2.6, -3.1), size_m: (1.0, 1.6, 0.8), tone: 1),
        (bone: "torso", centre_m: (-1.6, 2.6, -3.1), size_m: (1.0, 1.6, 0.8), tone: 1),

        // The cockpit: a frame around EYE_pilot, open glass between, a hatch gap in the roof.
        (bone: "cockpit", centre_m: (0.0, -0.7, 1.0), size_m: (2.6, 0.2, 2.6), tone: 3),
        (bone: "cockpit", centre_m: (0.0, -0.35, 1.9), size_m: (2.4, 0.5, 0.6), tone: 1),
        (bone: "cockpit", centre_m: (1.2, 0.5, 2.25), size_m: (0.15, 2.2, 0.15), tone: 3),
        (bone: "cockpit", centre_m: (-1.2, 0.5, 2.25), size_m: (0.15, 2.2, 0.15), tone: 3),
        (bone: "cockpit", centre_m: (0.0, 1.55, 1.7), size_m: (2.6, 0.12, 1.2), tone: 3),
        (bone: "cockpit", centre_m: (1.25, -0.3, 1.0), size_m: (0.15, 0.6, 2.6), tone: 3),
        (bone: "cockpit", centre_m: (-1.25, -0.3, 1.0), size_m: (0.15, 0.6, 2.6), tone: 3),
        (bone: "cockpit", centre_m: (0.0, -0.55, 2.25), size_m: (2.6, 0.3, 0.15), tone: 3),
        (bone: "cockpit", centre_m: (0.0, -0.45, 0.35), size_m: (0.7, 0.3, 0.7), tone: 1),
        (bone: "cockpit", centre_m: (0.0, 0.2, 0.0), size_m: (0.7, 1.2, 0.15), tone: 1),

        (bone: "shoulder_L", centre_m: (0.5, 0.0, 0.0), size_m: (1.4, 1.4, 1.8), tone: 2),
        (bone: "upper_arm_L", centre_m: (0.0, 0.0, 0.0), size_m: (1.0, 0.0, 1.0), along_m: Some((0.0, -2.4, 0.0)), tone: 0),
        (bone: "forearm_L", centre_m: (0.0, 0.0, 0.0), size_m: (0.9, 0.0, 0.9), along_m: Some((0.0, 0.0, 2.2)), tone: 0),
        (bone: "hand_L", centre_m: (0.0, 0.0, 0.6), size_m: (0.6, 0.6, 1.4), tone: 5),
        (bone: "shoulder_R", centre_m: (-0.5, 0.0, 0.0), size_m: (1.4, 1.4, 1.8), tone: 2),
        (bone: "upper_arm_R", centre_m: (0.0, 0.0, 0.0), size_m: (1.0, 0.0, 1.0), along_m: Some((0.0, -2.4, 0.0)), tone: 0),
        (bone: "forearm_R", centre_m: (0.0, 0.0, 0.0), size_m: (0.9, 0.0, 0.9), along_m: Some((0.0, 0.0, 2.2)), tone: 0),
        (bone: "hand_R", centre_m: (0.0, 0.0, 0.6), size_m: (0.6, 0.6, 1.4), tone: 5),

        (bone: "thigh_L", centre_m: (0.0, 0.0, 0.0), size_m: (1.1, 0.0, 1.2), along_m: Some((0.0, -2.4, 1.4)), tone: 0),
        (bone: "shin_L", centre_m: (0.0, 0.0, 0.0), size_m: (1.2, 1.0, 1.0), tone: 2),
        (bone: "shin_L", centre_m: (0.0, 0.0, 0.0), size_m: (0.9, 0.0, 0.9), along_m: Some((0.0, -1.9, -1.8)), tone: 0),
        (bone: "hock_L", centre_m: (0.0, 0.0, 0.0), size_m: (0.9, 0.9, 0.9), tone: 2),
        (bone: "hock_L", centre_m: (0.0, 0.0, 0.0), size_m: (0.7, 0.0, 0.7), along_m: Some((0.0, -1.1, 0.3)), tone: 1),
        (bone: "foot_L", centre_m: (0.0, -0.25, 0.4), size_m: (1.4, 0.5, 2.6), tone: 1),
        (bone: "toe_L", centre_m: (0.0, 0.15, 0.3), size_m: (1.2, 0.3, 0.6), tone: 5),
        (bone: "thigh_R", centre_m: (0.0, 0.0, 0.0), size_m: (1.1, 0.0, 1.2), along_m: Some((0.0, -2.4, 1.4)), tone: 0),
        (bone: "shin_R", centre_m: (0.0, 0.0, 0.0), size_m: (1.2, 1.0, 1.0), tone: 2),
        (bone: "shin_R", centre_m: (0.0, 0.0, 0.0), size_m: (0.9, 0.0, 0.9), along_m: Some((0.0, -1.9, -1.8)), tone: 0),
        (bone: "hock_R", centre_m: (0.0, 0.0, 0.0), size_m: (0.9, 0.9, 0.9), tone: 2),
        (bone: "hock_R", centre_m: (0.0, 0.0, 0.0), size_m: (0.7, 0.0, 0.7), along_m: Some((0.0, -1.1, 0.3)), tone: 1),
        (bone: "foot_R", centre_m: (0.0, -0.25, 0.4), size_m: (1.4, 0.5, 2.6), tone: 1),
        (bone: "toe_R", centre_m: (0.0, 0.15, 0.3), size_m: (1.2, 0.3, 0.6), tone: 5),
    ],
)
