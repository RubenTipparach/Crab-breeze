// its north-west and south-east through the puffs under its base toward the sun. The repeatable leg for finding the
// cause of the white flashes (docs/playtests/2026-10-27-sky-flicker.md).
//
//   ./target/release/crab-breeze --playtest storm-high
(
    name: "storm-high",
    stuck_s: 20.0,
    runs: [
        (
            play: "career-new",
            beats: [
                Wait(2.0),
                Board,
                Wait(150.0),
                JetTo(-7500.0, -6300.0, 650.0),
                JetTo(-3500.0, -2500.0, 650.0),
                Wait(3.0),
            ],
        ),
    ],
)
