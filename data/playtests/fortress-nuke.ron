// The Stratostacean brought down, its nuclear crash the finale (owner, 2026-10-31: "record a crab carrier fight using
// that explosion as the finale"): `fortress-down`'s fight in the Foreman, every leg and then half the hull (design
// section 12), flown on the jets; the pilot watches the mushroom cloud, then shoots down the stragglers. First person
// throughout.
//
//   CB_TAKE_SOUND=1 ./target/release/crab-breeze --playtest fortress-nuke --mech mechs/foreman.ron
(
    name: "fortress-nuke",
    stuck_s: 60.0,
    runs: [
        (
            play: "free",
            beats: [
                Wait(2.0),
                Board,
                Wait(2.0),
                SelectWeapon("autocannon"),
                StartMission("Fortress"),
                Wait(4.0),
                LookAtNearest("fortress", 4.0),
                BringDownFortress(1500.0),
                // the fireball, the rolling cap and the column, watched from where the fight ended
                LookAtNearest("nuke", 25.0),
                // then the stragglers: its fighters, its deck guard and any vehicle left (owner, 2026-10-31: "lets have
                // it shoot down the stragglers after downing the crab carrier")
                ClearHostiles(480.0),
            ],
        ),
    ],
)
