// Marks a mech leaves on the ground (openspec/changes/ground-marks): footprints, skate trails and
// crater scorches, all drawn in one draw call from a ring of `max_marks` (the oldest replaced
// first). Soil takes a deep, dark, broken print with a lip and clears the grass under it; paving
// takes a crushed, cracked print ringed with dust, no lip; water takes none. Read by
// cb_core::ground_marks::GroundMarksConfig. CB_NO_GROUND_MARKS=1 turns the marks off (the effects
// and the jolt stay).
(
    // 1024 marks of 160 bytes: a 160 KiB storage buffer, one draw of 25 600 vertices.
    max_marks: 1024,
    lay_within_m: 800.0,
    draw_within_m: 450.0,
    lift_m: 0.15,

    // The stand-in's sole is 1.4 m by 2.6 m, its middle 0.4 m ahead of the ankle
    // (data/mechs/placeholder.ron, box on foot_L); the print is a little bigger than the sole.
    foot_half_width_m: 0.8,
    foot_half_length_m: 1.3,
    sole_ahead_m: 0.4,
    foot_life_s: 90.0,
    landing_depth_scale: 1.6,

    // A wheel lays a segment every 4 m it glides: at 40 m/s, 10 a second a wheel.
    trail_half_width_m: 0.45,
    trail_segment_m: 4.0,
    trail_break_m: 14.0,
    trail_life_s: 40.0,
    trail_min_speed_m_s: 1.0,
    skate_fx_min_m_s: 5.0,

    crater_life_s: 240.0,

    // No grass stands on a soil print or skate groove for its life: every 1 m grass cell whose
    // middle lies within the sole (or the groove's width) and this margin is cleared.
    crush_margin_m: 0.3,

    // Deep enough to read as a line of prints across a meadow from 30 m.
    dirt: (
        foot_depth_m: 0.32,
        foot_lip_m: 0.14,
        trail_depth_m: 0.22,
        trail_lip_m: 0.08,
        crater_depth_m: 0.15,
    ),
    // A 10 cm dent, so the parallax shows it; skate lines are rubber, 1 cm of scuff.
    concrete: (
        foot_depth_m: 0.1,
        foot_lip_m: 0.0,
        trail_depth_m: 0.01,
        trail_lip_m: 0.0,
        crater_depth_m: 0.05,
    ),

    // The pilot's eye drops and recovers on the piloted mech's foot strikes: position only, never
    // the view's direction (CLAUDE.md section 8). 1 cm standing, 0.2 cm more per m/s, at most 4 cm;
    // a landing 7 cm; over 0.15 s.
    jolt: (
        step_cm: 1.0,
        per_m_s_cm: 0.2,
        max_cm: 4.0,
        landing_cm: 7.0,
        duration_s: 0.15,
        side_share: 0.25,
    ),

    // The shader's numbers (all multiply the ground; above 1 lightens). Soil: the bottom of a print
    // toward a dark brown that turns the green-tinted meadow ground brown. Paving: the sole crushed
    // to half, broken into slabs about 0.35 m across, cracks 8 cm wide at the root reaching 1.7 sole
    // half lengths (about 1.5 times the sole), and a ring of pale dust.
    look: (
        soil_tint: (0.8, 0.42, 0.36),
        pit_dark: 0.45,
        crack_colour: (0.22, 0.21, 0.2),
        crack_width_m: 0.08,
        crack_reach: 1.7,
        scuff: 0.5,
        slab_m: 0.35,
        dust_brighten: 1.35,
        ambient: 0.7,
        pull_per_m: 0.002,
    ),
)
