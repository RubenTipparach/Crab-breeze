// The Stratostacean, the crab air fortress (openspec/changes/crab-airship, design sections 1 to 6 and 9). Its shape (parts,
// platforms, hull) is data/missions/fortress_shape.ron, measured off the model. First estimates, tuned from a run.
(
    // Its name (owner, 2026-10-26, survey H2: "the Stratostacean").
    name: "Stratostacean",
    mass_t: 60000.0,
    altitude_m: 600.0,
    circle_radius_m: 380.0,
    speed_m_s: 15.0,
    drive_stop_s: 20.0,
    // A lift thruster carries a quarter of the weight at most, a hull thruster a sixth (sections 2, 2b).
    lift_max_share: 0.25,
    hull_max_share: 0.1666667,
    sink_drag_per_m: 0.008,
    list_deg_per_weight: 100.0,
    list_rate_deg_s: 4.0,
    hold_time_s: 1.2,
    doors_open_s: 3.0,
    hull_light_s: 4.0,
    turret_turn_deg_s: 60.0,
    fire_cone_deg: 5.0,
    // The spikes (the model's DETAIL_ meshes) draw only this close to their origin, fading over the last 100 m (owner,
    // 2026-10-25: "spikes should not render until we are up close").
    detail_range_m: 700.0,
    // Fairer (owner, 2026-10-29: "the crab carrier is too hard to beat. There are way too many targets to even see it properly", "1/2 weapons, weapons should not all target you at once, maybe 3 at a time, and have some way of telegraphing shots. lasers sweep, rail guns should have railgun warning so player can dodge", "turrets should fire in bursts, then have 15 second cooldowns"):
    // - only the lift thrusters and the bridge are boxed and lockable all the time; a gun is boxed while it warns, fires
    //   or burns and 4 s after (51 parts were boxed at once). Every part can still be shot;
    // - one gun in two is armed (`armed_every: 2`): 5 flak, 4 deck guns, 2 beams, 2 launchers and 1 battery;
    // - at most 3 of them warn, fire or burn at you at once;
    // - every gun warns 1.5 s before its burst (the HUD's red INCOMING line, its box), then pauses 15 s after it;
    // - the beams sweep 40 m to each side across where you stood when they began to charge: move off the line.
    fire_box_s: 4.0,
    max_firing: 3,
    kinds: {
        "lift": (
            name: "Lift thruster", hp: 800.0, armour_mm: 60.0, always_target: true,
            // owner, 2026-10-25: "armor on the thrusters facing outward", "should be damageable from this side"
            weak: Lift(plate_mm: 300.0, below_m: 18.0, above_m: 18.0),
            capsule: (radius_m: 16.5, half_m: 20.0),
        ),
        "hull": (
            name: "Hull thruster", hp: 900.0, armour_mm: 300.0,
            weak: Port(within_deg: 30.0),
            capsule: (radius_m: 12.0, half_m: 30.0, centre_y_m: 5.0),
        ),
        "drive": (name: "Drive thruster", hp: 600.0, armour_mm: 140.0, capsule: (radius_m: 12.0, half_m: 0.0)),
        "flak": (
            name: "Flak turret", hp: 150.0, armour_mm: 60.0, armed_every: 2,
            capsule: (radius_m: 6.0, half_m: 1.5, centre_y_m: 4.0),
            gun: Some((
                weapon: (name: "105 mm flak", socket: "MUZZLE", arm: Torso, group: 0, speed_m_s: 900.0,
                         interval_s: 0.5, penetration_mm: 60.0, damage: 8.0, blast_mj: 1.0),
                range_m: 1800.0, burst: 4, pause_s: 15.0, aim_error_deg: 1.5, elev_deg: (-10.0, 85.0), proximity_m: 10.0,
                warn_s: 1.5,
            )),
        ),
        "beam": (
            name: "Beam turret", hp: 250.0, armour_mm: 120.0, weak: WhileCharging, armed_every: 2,
            capsule: (radius_m: 7.0, half_m: 3.0, centre_y_m: -7.0),
            gun: Some((
                weapon: (name: "beam", socket: "MUZZLE", arm: Torso, group: 0, speed_m_s: 1.0,
                         interval_s: 1.0, penetration_mm: 1.0, damage: 1.0, blast_mj: 0.0),
                range_m: 900.0, burst: 1, pause_s: 15.0, aim_error_deg: 0.0, elev_deg: (-90.0, 10.0),
                beam: Some((charge_s: 1.5, on_s: 3.0, damage_per_s: 10.0, sweep_m: 40.0, hit_m: 6.0)),
            )),
        ),
        "gun": (
            name: "Deck gun", hp: 100.0, armour_mm: 30.0, armed_every: 2,
            capsule: (radius_m: 3.0, half_m: 1.0, centre_y_m: 2.0),
            gun: Some((
                weapon: (name: "30 mm gatling", socket: "MUZZLE", arm: Torso, group: 0, speed_m_s: 1000.0,
                         interval_s: 0.05, penetration_mm: 40.0, damage: 1.5, blast_mj: 0.0),
                range_m: 600.0, burst: 20, pause_s: 15.0, aim_error_deg: 1.0, elev_deg: (-20.0, 80.0), warn_s: 1.5,
            )),
        ),
        "msl": (
            // owner, 2026-10-25: "crab needs missile launchers"
            name: "Missile launcher", hp: 300.0, armour_mm: 60.0, weak: WhileFiring, armed_every: 2,
            capsule: (radius_m: 9.0, half_m: 3.0, centre_y_m: 8.0),
            gun: Some((
                weapon: (name: "crab missile", socket: "MUZZLE", arm: Torso, group: 0, speed_m_s: 220.0,
                         interval_s: 0.25, penetration_mm: 150.0, damage: 35.0, blast_mj: 2.0, kind: Rocket,
                         seeker_turn_deg_s: 45.0),
                range_m: 2500.0, burst: 6, pause_s: 15.0, aim_error_deg: 2.0, elev_deg: (14.0, 69.0), warn_s: 1.5,
            )),
        ),
        "vls": (
            name: "Missile battery", hp: 200.0, armour_mm: 60.0, armed_every: 2,
            capsule: (radius_m: 8.0, half_m: 2.0, centre_y_m: 2.0),
            gun: Some((
                weapon: (name: "crab missile", socket: "MUZZLE", arm: Torso, group: 0, speed_m_s: 220.0,
                         interval_s: 5.0, penetration_mm: 150.0, damage: 35.0, blast_mj: 2.0, kind: Rocket,
                         seeker_turn_deg_s: 45.0),
                range_m: 2500.0, burst: 1, pause_s: 15.0, aim_error_deg: 0.0, elev_deg: (90.0, 90.0), turns: false, warn_s: 1.5,
                magazine: 12,
            )),
        ),
        "cat": (name: "Catapult", hp: 400.0, armour_mm: 100.0, capsule: (radius_m: 3.0, half_m: 0.0, centre_y_m: 1.0)),
        "bay": (name: "Drop bay", hp: 600.0, armour_mm: 140.0, capsule: (radius_m: 12.0, half_m: 0.0)),
        "hlift": (name: "Hangar lift", hp: 400.0, armour_mm: 100.0, capsule: (radius_m: 8.0, half_m: 0.0)),
        "bridge": (
            name: "Bridge", hp: 1200.0, armour_mm: 140.0, weak: Above(y_m: 40.0), always_target: true,
            capsule: (radius_m: 18.0, half_m: 14.0, centre_y_m: 24.0),
        ),
    },
    // 4 fighters up at most, was 8 (fewer targets, 2026-10-29).
    launch: (unit: "fighter", interval_s: 20.0, first_s: 8.0, max_airborne: 4, hangar: 24, off_m: (0.0, 3.0, 64.0)),
    // The deck guard (owner, 2026-10-26, survey H6: "2 Shrikes and 4 Mites on deck, a Mite up each hangar lift every
    // 60 s"). Posts from the approved mockup: the Shrikes on the flight deck, the Mites on the shoulders. Each lift
    // brings a Mite every 60 s while it works, fewer than 6 stand and the 8 below decks last (design section 4). They
    // keep to the tops they stand on, and do not hop on their jets.
    guard: (
        start: [
            (crab: "shrike", at_m: (0.0, 40.0)),
            (crab: "shrike", at_m: (0.0, -105.0)),
            (crab: "mite", at_m: (60.0, 60.0)),
            (crab: "mite", at_m: (-60.0, -40.0)),
            (crab: "mite", at_m: (-60.0, 85.0)),
            (crab: "mite", at_m: (60.0, -80.0)),
        ],
        lift_crab: "mite",
        lift_interval_s: 60.0,
        max_on_deck: 6,
        hangar: 8,
        crabs: {
            "shrike": (
                mech: "mechs/placeholder.ron",
                skin: Some("shrike"),
                tint: Some((0.45, 0.16, 0.12)),
                armour_scale: 0.55,
                weapons: Some([
                    (name: "25 mm autocannon", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 1100.0,
                     interval_s: 0.2, penetration_mm: 55.0, damage: 6.0, blast_mj: 0.3),
                ]),
                skill: (aim_noise_deg: 3.5, fire_error_deg: 3.0, range_m: 120.0, max_fire_range_m: 700.0, hop_chance: 0.0),
            ),
            "mite": (
                mech: "mechs/placeholder.ron",
                skin: Some("mite"),
                tint: Some((0.55, 0.20, 0.14)),
                armour_scale: 0.55,
                weapons: Some([
                    (name: "25 mm autocannon", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 1100.0,
                     interval_s: 0.2, penetration_mm: 55.0, damage: 6.0, blast_mj: 0.3),
                ]),
                skill: (aim_noise_deg: 3.0, fire_error_deg: 3.0, range_m: 80.0, max_fire_range_m: 700.0, hop_chance: 0.0),
            ),
        },
    ),
    downwash: (radius_top_m: 15.0, radius_bottom_m: 30.0, length_m: 150.0, push_m_s2: 25.0, burn_per_s: 15.0),
    leg: (blast_mj: 30.0, break_radius_m: 25.0, tumble_deg_s: 25.0),
    // Its wreck breaks what is under its 280 x 420 m footprint and 60 m round it; those are the attacked city's
    // cells, so the crash counts as city damage (owner, 2026-10-26, survey H5).
    crash: (clearance_m: 40.0, blast_mj: 200.0, break_margin_m: 60.0, half_size_m: (140.0, 210.0)),
)
