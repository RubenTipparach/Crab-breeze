// The city defence mission (openspec/changes/city-defence). Three waves of 10 raiders, one wave
// per city (largest first: wave 1 attacks the city the pilot starts in). Destroy every raider of a
// wave within `wave_time_s` of it appearing; the mission is lost if the attacked city's damage
// (the share of its building cells destroyed) passes `lose_damage`, or if the pilot's mech falls.
// The siege bursts are a first estimate (design section 4): retune them from a run's
// `MISSION status` log, not by guesswork.
(
    cities: [0, 1, 2],
    raiders_per_wave: 10,
    wave_time_s: 600.0,
    lose_damage: 0.5,
    lull_s: 20.0,
    spawn_distance_m: 450.0,
    spawn_arc_deg: 100.0,
    spawn_jitter_m: 30.0,
    // Inside the city, in its streets (owner, 2026-10-24: "Make sure enemies spawn in the city").
    spawn_inside_fraction: 0.5,
    spawn_clearance_m: 8.0,
    edge_margin_m: 150.0,
    // 2, not 3, since each wave also brings vehicles (invasion-forces, 2026-10-24).
    max_on_player: 2,
    engage_player_m: 300.0,
    grudge_s: 8.0,
    grudge_range_m: 700.0,
    siege_burst_s: 1.0,
    siege_pause_s: 5.0,
    facade_out_m: 2.0,
    // Cycled through each wave in order. Of 10 raiders, numbers 3 and 10 carry rockets, 4 a shotgun, 5 a laser, 6 a
    // plasma cannon and 7 a railgun with a six-cell multi-lock pod (openspec/changes/weapon-kinds; survey G22, owner, 2026-10-26: anyone can carry
    // every weapon, on both sides, so the crabs and the human mechs alike). Speeds m/s, intervals s, penetration mm,
    // blast MJ, heat a share of the weapon heat bank (a shot, or a second of beam).
    raiders: [
        (
            mech: "mechs/placeholder.ron",
            // Crabs by default (owner, 2026-10-25: "only crabs for now"); jobs' enemies wear these.
            skin: Some("pincher"),
            tint: Some((0.55, 0.20, 0.14)),
            armour_scale: 0.55,
            weapons: Some([
                (name: "25 mm autocannon", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 1100.0,
                 interval_s: 0.2, penetration_mm: 55.0, damage: 6.0, blast_mj: 0.3),
            ]),
            skill: (aim_noise_deg: 3.0, fire_error_deg: 3.0, range_m: 200.0, max_fire_range_m: 700.0),
        ),
        (
            mech: "mechs/placeholder.ron",
            skin: Some("shrike"),
            tint: Some((0.45, 0.16, 0.12)),
            armour_scale: 0.55,
            weapons: Some([
                (name: "25 mm autocannon", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 1100.0,
                 interval_s: 0.2, penetration_mm: 55.0, damage: 6.0, blast_mj: 0.3),
            ]),
            skill: (aim_noise_deg: 3.5, fire_error_deg: 3.0, range_m: 240.0, max_fire_range_m: 700.0),
        ),
        (
            mech: "mechs/placeholder.ron",
            skin: Some("bruiser"),
            tint: Some((0.35, 0.30, 0.16)),
            armour_scale: 0.55,
            weapons: Some([
                (name: "90 mm rocket pod", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 240.0,
                 interval_s: 1.6, penetration_mm: 120.0, damage: 30.0, blast_mj: 2.0, kind: Rocket),
            ]),
            skill: (aim_noise_deg: 2.0, fire_error_deg: 2.5, range_m: 320.0, max_fire_range_m: 800.0, hop_chance: 0.2),
        ),
        (
            mech: "mechs/placeholder.ron",
            skin: Some("hatchet"),
            tint: Some((0.40, 0.24, 0.14)),
            armour_scale: 0.55,
            weapons: Some([
                (name: "shotgun", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 600.0, interval_s: 1.0,
                 penetration_mm: 40.0, damage: 9.0, blast_mj: 0.0, kind: Pellets(count: 12, spread_deg: 1.5)),
            ]),
            skill: (aim_noise_deg: 3.0, fire_error_deg: 3.0, range_m: 120.0, max_fire_range_m: 250.0, hop_chance: 0.4),
        ),
        (
            mech: "mechs/placeholder.ron",
            skin: Some("shrike"),
            tint: Some((0.50, 0.18, 0.22)),
            armour_scale: 0.55,
            weapons: Some([
                (name: "laser", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 1500.0, interval_s: 0.1,
                 penetration_mm: 120.0, damage: 60.0, blast_mj: 0.0, kind: Beam(range_m: 1500.0), heat: 0.25),
            ]),
            skill: (aim_noise_deg: 2.0, fire_error_deg: 2.0, range_m: 400.0, max_fire_range_m: 1200.0),
        ),
        (
            mech: "mechs/placeholder.ron",
            skin: Some("bruiser"),
            tint: Some((0.30, 0.22, 0.36)),
            armour_scale: 0.55,
            weapons: Some([
                (name: "plasma cannon", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 180.0, interval_s: 1.6,
                 penetration_mm: 80.0, damage: 55.0, blast_mj: 4.0, kind: Plasma(burst_m: 650.0), heat: 0.2),
            ]),
            skill: (aim_noise_deg: 2.5, fire_error_deg: 3.0, range_m: 300.0, max_fire_range_m: 450.0),
        ),
        (
            mech: "mechs/placeholder.ron",
            skin: Some("brigand"),
            tint: Some((0.32, 0.30, 0.26)),
            armour_scale: 0.55,
            weapons: Some([
                (name: "railgun", socket: "MUZZLE_R", arm: ArmR, group: 0, speed_m_s: 2400.0, interval_s: 4.0,
                 penetration_mm: 400.0, damage: 140.0, blast_mj: 0.0, kind: Slug(charge_s: 1.0), heat: 0.35),
                (name: "multi-lock pod", socket: "MISSILE_POD", arm: Torso, group: 2, speed_m_s: 240.0, interval_s: 8.0,
                 penetration_mm: 100.0, damage: 30.0, blast_mj: 1.5, kind: Rocket, rounds: Some(24),
                 seeker: Some((max_locks: 6, lock_s: 0.35, range_m: 1500.0, cone_deg: 25.0, turn_deg_s: 60.0))),
            ]),
            skill: (aim_noise_deg: 1.5, fire_error_deg: 1.0, range_m: 700.0, max_fire_range_m: 2000.0, hop_chance: 0.1),
        ),
    ],
    // Each wave's skins (openspec/changes/blockout-enemies, E1, provisional): raider i of a wave wears its list's
    // i-th, cycled. Crabs only for now (owner, 2026-10-25: "only crabs for now, some missions will be human
    // mechs, but crab mechs for the default"): small crabs first, then the bigger ones, then a Tyrant leading.
    skins_by_wave: [
        ["scuttler", "mite", "pincher", "shrike", "scuttler", "mite", "pincher", "shrike", "scuttler", "mite"],
        ["pincher", "shrike", "bruiser", "scuttler", "pincher", "shrike", "bruiser", "mite", "pincher", "shrike"],
        ["tyrant", "bruiser", "pincher", "shrike", "bruiser", "scuttler", "mite", "pincher", "shrike", "bruiser"],
    ],
    // Each wave's vehicles beside its raiders (openspec/changes/invasion-forces, survey G16,
    // provisional): tanks come by cargo plane and parachute. Lightened 2026-10-24 for the full
    // three-wave take: at 4 tanks and 2 helicopters a wave the scripted pilot fell in wave 1. The crab airship joins wave 3 when it
    // is built. A wave is cleared when its raiders and these are all destroyed.
    forces: [
        [
            (unit: "tank", count: 2, by_air: true, per_plane: 2),
            (unit: "helicopter", count: 1),
        ],
        [
            (unit: "tank", count: 2, by_air: true, per_plane: 2),
            (unit: "helicopter", count: 1),
            (unit: "fighter", count: 1),
        ],
        [
            (unit: "helicopter", count: 2),
            (unit: "fighter", count: 2),
        ],
    ],
)
