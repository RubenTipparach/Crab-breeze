// How a career starts (openspec change career). Owner, 2026-10-25, survey J4: "start with 1000 credits";
// jobs pay 40 000-150 000 and mechs cost 300 000-1 200 000 (mission-jobs, air-bases).
(
    start_money: 1000,
    start_mech: "mechs/foreman.ron",
    ledger_kept: 200,
    // Standing with a base (career-progression, provisional CP2: it only changes pay, never closes a base):
    // one point a job won, one lost a job failed or abandoned, at most 10, each point paying 5 % more.
    standing_per_job: 1,
    standing_lost: 1,
    standing_max: 10,
    pay_bonus_per_standing: 0.05,
)
