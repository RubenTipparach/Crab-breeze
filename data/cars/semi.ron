// A cab-over tractor and a box trailer, as one rigid body for now (its wheelbase sets how wide it turns).
// A 1980s civilian car, no real brand (survey J7). Handling is arcade, grippy and simple (survey J8):
// openspec/changes/car-driving/design.md section 2. Sizes are the block-out's, in metres; the car
// faces -z; sockets are in its frame (x right, y up from the ground, z back).
(
    name: "Semi truck",
    model: "models/cars/semi.glb",
    size_m: (2.55, 4.0, 16.5),
    mass_kg: 25000.0,
    // light steel and glass: any real gun's round goes through
    armour_mm: 5.0,
    city_weight: 0.1,
    highway_weight: 1.5,
    top_speed_m_s: 28.0,
    reverse_fraction: 0.333,
    accel_m_s2: 0.9,
    brake_m_s2: 5.5,
    coast_m_s2: 0.8,
    wheelbase_m: 10.0,
    track_m: 2.1,
    max_steer_deg: 35.0,
    top_speed_steer_fraction: 0.2,
    steer_rate_rad_s: 3.0,
    lateral_grip_per_s: 60.0,
    handbrake_grip: 0.3,
    grip_recover_per_s: 2.0,
    handbrake_yaw_gain: 0.8,
    handbrake_brake_m_s2: 3.0,
    ride_height_m: 0.5,
    spring_n_m: 300000.0,
    damper_n_s_m: 30000.0,
    crash_safe_m_s: 3.0,
    crash_damage_per_m_s: 0.04,
    eye_driver_m: (-0.6, 2.65, -6.9),
    door_driver_m: (-1.78, 0.0, -6.9),
    speedo_full_scale_km_h: 140.0,
    speedo_sweep_deg: 240.0,
    paints: [(0.85, 0.85, 0.85), (0.6, 0.1, 0.08), (0.12, 0.2, 0.4)],
)
