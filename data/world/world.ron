// World generation tuning (openspec/changes/procgen-world/design.md and
// openspec/changes/island-world/design.md). Units are in the keys.
// The yardstick is the 12 m mech (survey M1) and the 1.8 m pilot.
(
    // An island in the sea, 40,960 m a side (ten times the first world's side; owner, 2026-10-24).
    world_size_m: 40960.0,
    terrain_cell_m: 8.0,
    noise_wavelength_m: 1100.0,
    noise_amplitude_m: 28.0,
    noise_octaves: 4,
    noise_persistence: 0.5,

    // The island (island-world design section 2): land out to about 13 km from the centre, its edge
    // moved in or out by up to 2.5 km of coast noise, falling over a 3 km shelf to a sea floor
    // 38 m (29 to 47 m) down, shallow enough for a sunk 12 m mech to walk back ashore.
    island: (
        sea_level_m: 0.0,
        land_radius_m: 13000.0,
        coast_noise_m: 2500.0,
        coast_wavelength_m: 6000.0,
        land_height_m: 50.0,
        highland_m: 90.0,
        shelf_m: 3000.0,
        sea_depth_m: 38.0,
        floor_noise_m: 9.0,
        floor_wavelength_m: 1500.0,
        edge_fade_m: 1500.0,
    ),

    // The mountain range (openspec/changes/hydrology/design.md section 1): a crater of mountains
    // round the island's middle (owner, 2026-10-25: "need a crater like moutain range at center of
    // islan"). The rim's crest is a 5.5 km circle, the range 6 km wide, peaks to about 1.6 km with
    // snow above 900 m, smooth ridges (five octaves, no terraces). A 60 m cliff band runs 1.8 km
    // each side of the crest: inside it is the crater's wall, which the streams fall over to the
    // crater floor where the capital stands. Three passes (north-east, south-south-east, west) let
    // the rivers and highways out. Cities stay below 260 m on land within 70 m of level; highways
    // do not climb over the rim.
    range: (
        centre_m: (0.0, 0.0),
        radius_m: 5500.0,
        half_width_m: 3000.0,
        peak_m: 1700.0,
        ridge_wavelength_m: 3600.0,
        ridge_octaves: 5,
        warp_m: 900.0,
        snowline_m: 900.0,
        scarp_offset_m: 1800.0,
        scarp_m: 60.0,
        scarp_width_m: 14.0,
        scarp_wobble_m: 300.0,
        passes_deg: [35.0, 160.0, 265.0],
        pass_width_deg: 10.0,
    ),
    city_max_ground_m: 260.0,
    city_max_relief_m: 70.0,
    highway_max_climb_m: 45.0,

    // The biomes (openspec/changes/island-biomes/design.md section 1): the island dries toward the
    // east-south-east, the lee of the westerlies, from 2 km west of the centre to 12 km east, its
    // edge wandering 2.5 km; a quarter of the land is desert, with savanna then grassland fading in
    // over wide bands, conifer forest on the range's moist flanks, bare rock below the snow, beaches
    // and marsh on wet low ground. Every border fades over a band; none is a straight line.
    biomes: (
        dry_toward: (0.92, 0.38),
        dry_from_m: -2000.0,
        dry_to_m: 12000.0,
        wander_m: 3500.0,
        wander_wavelength_m: 6500.0,
        patch_share: 0.25,
        patch_wavelength_m: 3000.0,
        desert_moisture: 0.40,
        border_band: 0.13,
        wetland_moisture: 0.8,
        height_jitter_m: 120.0,
        alpine_band_m: 250.0,
        montane_m: (250.0, 450.0),
        rock_slope: (0.9, 1.4),
        beach_m: 4.0,
    ),
    city_count: 24,
    city_attempts: 4000,
    city_min_spacing_m: 2600.0,
    open_ground_min_m: 600.0,
    city_edge_margin_m: 300.0,
    capital_within_m: 2500.0,
    city_half_size_m: (280.0, 480.0),
    plateau_flat_margin_m: 12.0,
    plateau_blend_m: 120.0,

    block_size_m: (70.0, 110.0),
    street_width_m: 24.0,
    arterial_width_m: 36.0,
    arterial_every: 4,
    sidewalk_m: 4.0,
    lot_size_m: (18.0, 36.0),
    setback_m: (1.0, 3.0),
    park_block_chance: 0.06,
    plaza_lot_chance: 0.08,

    storey_height_m: 3.5,
    storeys_downtown: (24.0, 60.0),
    storeys_edge: 2,
    storey_falloff_exponent: 0.7,
    storey_fill: (0.35, 1.0),

    highway_width_m: 28.0,
    highway_flat_margin_m: 12.0,
    highway_blend_m: 60.0,
    road_lift_m: 0.1,
    kerb_height_m: 0.2,

    start_pilot_distance_m: 25.0,

    // Levels of detail of the drawn ground (island-world design section 1): 512 m chunks at full
    // detail within 700 m of the eye, every 2nd sample within 1.4 km, then 4, 8, 16, and 32 past
    // 11.2 km (about 1 degree a quad at every ring). The chunks are the leaves of a quadtree whose
    // roots are 8 km squares (16 x 16 chunks): a node is one mesh of 64 x 64 quads at step
    // 2^level, split only where the eye is near, so the whole island is about 90 ground meshes
    // (owner, 2026-10-24: "make sure to lower draw calls").
    terrain_lod: (
        chunk_cells: 64,
        ring_m: [700.0, 1400.0, 2800.0, 5600.0, 11200.0],
        hysteresis_m: 64.0,
        collider_radius_m: 400.0,
        builds_per_frame: 6,
        max_level: 4,
    ),

    // How far the pilot sees (island-world design section 5).
    view: (
        far_m: 40000.0,
        // The scattering sky hazes the distance itself (sky-atmosphere); the flat fog stays thin.
        clear_visibility_m: 20000.0,
        exposure_ev100: 13.4,
        // The sun disk 2 degrees across (the real 0.53 reads as a dot), twice as bright.
        sun_disk_deg: 2.0,
        sun_disk_intensity: 2.0,
    ),

    // Rivers, lakes and waterfalls (openspec/changes/hydrology/design.md). Water drains over a
    // 128 m grid: snowmelt above the range's snowline, a twelfth as much rain below it, summed
    // downhill; 12 snow cells' worth makes a stream 10 m wide, which widens by the square root of its
    // flow to 56 m. Basins 8 m deep and 16 cells wide that a stream feeds are lakes, the ten largest
    // (owner, 2026-10-25: "too many lakes"). A river that drops 12 m in one
    // 16 m step (a cliff, not a steep slope) for 25 m or more is a waterfall, with a plunge pool under it.
    water: (
        city_freeboard_m: 2.0,
        drainage_cell_m: 128.0,
        lowland_rain: 0.08,
        melt_band_m: 400.0,
        stream_min_flow: 12.0,
        stream_min_cells: 3,
        river_step_m: 16.0,
        river_city_clearance_m: 80.0,
        stream_half_width_m: 5.0,
        river_max_half_width_m: 28.0,
        river_depth_m: 7.0,
        freeboard_m: 2.0,
        bank_slope: 0.45,
        flow_m_s: 1.5,
        lake_min_depth_m: 8.0,
        lake_min_cells: 16,
        lake_max_count: 10,
        lake_radius_m: (70.0, 900.0),
        lake_depth_m: 14.0,
        lake_shore_wobble: 0.12,
        fall_step_m: 12.0,
        fall_min_height_m: 25.0,
        plunge_radius_per_m: 1.4,
    ),

    // Trees (openspec/changes/vegetation, grown by tile near the bodies: island-world design
    // section 3). The woods are as dense as before; only the tiles near the pilot and the mechs exist.
    // Denser, farther woods (owner, 2026-10-24: "More trees please", but "100k is probably a bit
    // much" as entities) wait for GPU-driven trees, placed and culled in a compute shader.
    // Drawn to 2 km (owner, 2026-10-24: "Trees should have max distance of 2km"): grown to 2.2 km,
    // let go past 2.7 km.
    trees: (
        tile_sites: 24,
        keep_radius_m: 2200.0,
        urgent_radius_m: 400.0,
        release_radius_m: 2700.0,
        tiles_per_step: 2,
        draw_radius_m: 2000.0,
    ),

    // Clouds over the island and 6 km of sea past the world's edge, drawn within 9 km of the eye.
    // Back on as lumpy lit blobs, one mesh per 2 km tile (openspec/changes/cloud-puffs): one blended
    // layer per blob instead of the sprite stacks that cost heavy overdraw. To be measured on the
    // owner's hardware with CB_NO_CLOUDS against the same take.
    clouds: (
        coverage: 0.35,
        look_wrap: 0.6,
        look_silver: 1.6,
        look_albedo: 0.9,
        look_base_shade: 0.45,
        look_near_fade_m: 160.0,
        look_edge_softness: 0.45,
        spacing_m: 1000.0,
        beyond_world_m: 6000.0,
        draw_radius_m: 9000.0,
    ),
)
