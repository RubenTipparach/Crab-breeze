// World generation tuning (openspec/changes/procgen-world/design.md and
// openspec/changes/island-world/design.md). Units are in the keys.
// The yardstick is the 12 m mech (survey M1) and the 1.8 m pilot.
(
    // An island in the sea, 40,960 m a side (ten times the first world's side; owner, 2026-10-24).
    world_size_m: 40960.0,
    terrain_cell_m: 8.0,

    // The island (openspec/changes/island-biomes; owner, 2026-10-25: "I wanted this island"): the
    // island mockup's land (docs/mockups/island_gen.js, ported to cb-core world::island), so seed
    // 42 is the island the mockup shows: a range on a curved spine through the middle, running
    // north-north-east, peaks to about 2 km with passes for the highways; the desert plateau in its
    // rain shadow to the east, with mesas, dunes and canyons; beaches and a reef on the wide
    // shelves, sea cliffs on the north-east; an archipelago off the south-west. The deep sea falls
    // to 230 m and rises to the flat floor drawn past the world's edge over the last 2.5 km.
    island: (
        sea_level_m: 0.0,
        sea_depth_m: 120.0,
        edge_fade_m: 2500.0,
        // Snow from 1,450 m: the rivers' melt comes from the range above it.
        snowline_m: 1450.0,
    ),
    city_max_ground_m: 300.0,
    city_max_relief_m: 70.0,
    highway_max_climb_m: 45.0,
    // Highways are routed, not ruled (openspec/changes/curved-roads/design.md; owner, 2026-10-25:
    // "roads shouldnt be straight like that"): an A* over the 128 m drainage cells, a step at a 6 %
    // grade costing seven times one on the level, a stream crossing 600 m more, swinging up to
    // 4 km out of the way, smoothed into curves and graded on the land averaged over 240 m.
    highway_max_grade: 0.06,
    highway_slope_cost: 6.0,
    highway_bridge_cost_m: 600.0,
    highway_detour_m: 4000.0,
    highway_grade_smooth_m: 240.0,

    // The biomes (openspec/changes/island-biomes, the mockup's ten): moisture falls across 12 km
    // east of the spine, the rain shadow of the westerlies; the desert takes over below 0.48, which
    // makes desert and canyon a quarter of the land; swamps 2.6 km across at the western river
    // mouths.
    biomes: (
        desert_moisture: 0.48,
        swamp_radius_m: 2600.0,
    ),
    city_count: 24,
    city_attempts: 4000,
    city_min_spacing_m: 2600.0,
    open_ground_min_m: 600.0,
    city_edge_margin_m: 300.0,
    // The capital stands nearest the centre where the land allows: the range fills the middle, so
    // within 9 km (the mockup's capital is on the northern plain about 7.5 km out).
    capital_within_m: 9000.0,
    city_half_size_m: (280.0, 480.0),
    plateau_flat_margin_m: 12.0,
    plateau_blend_m: 120.0,

    block_size_m: (70.0, 110.0),
    street_width_m: 24.0,
    arterial_width_m: 36.0,
    arterial_every: 4,
    sidewalk_m: 4.0,
    lot_size_m: (18.0, 36.0),
    setback_m: (1.0, 3.0),
    park_block_chance: 0.06,
    plaza_lot_chance: 0.08,

    storey_height_m: 3.5,
    storeys_downtown: (24.0, 60.0),
    storeys_edge: 2,
    storey_falloff_exponent: 0.7,
    storey_fill: (0.35, 1.0),

    highway_width_m: 28.0,
    highway_flat_margin_m: 12.0,
    highway_blend_m: 60.0,
    // The sun's shadows (openspec/changes/distant-shadows). Far ground wears the terrain's own
    // shadow, baked once at load on a 40 m grid, and keeps 0.55 of its colour in shade. Near the eye
    // the live shadow maps draw everything: three cascades, the first to 40 m, out to 700 m where
    // far ground begins (owner, 2026-10-25: "when I walk up to it within like 500m or so then it can
    // render as normally").
    sun_shade: (
        cell_m: 40.0,
        soft_m: 4.0,
        shade_albedo: 0.55,
        live_cascades: 3,
        live_first_cascade_m: 40.0,
        live_far_m: 700.0,
    ),
    road_lift_m: 0.15,
    kerb_height_m: 0.2,
    // The roads' CC0 sets (road-surfaces): the owner's picks, 2026-10-27, "26c suburban Streets 27c for
    // downtown": Asphalt027C on the cities' streets, arterials and highways, Asphalt026C on the suburbs' streets
    // and car parks, each in its own colour (arterials a little darker); Asphalt022, worn, on patch repairs and
    // runways. The tone drifts by up to 22% over about 45 m, every lane has two darker tyre tracks, and about
    // one lane cell in sixteen is a patch repair, so a street is not one colour and no tile repeat lines up
    // from the cockpit.
    road_surfaces: (
        street_tile_m: 4.0,
        suburb_tile_m: 4.0,
        worn_tile_m: 1.85,
        paving_tile_m: 2.4,
        street_tone: (1.0, 1.0, 1.0),
        arterial_tone: (0.84, 0.84, 0.86),
        suburb_tone: (1.0, 1.0, 1.0),
        worn_tone: (0.25, 0.24, 0.22),
        tint_cell_m: 8.0,
        tint_scale_m: 45.0,
        tint_amount: 0.22,
        lane_m: 3.5,
        track_offset_m: 0.9,
        track_half_m: 0.5,
        track_dark: 0.22,
        patch_chance: 0.06,
        patch_tone: 0.75,
    ),

    start_pilot_distance_m: 25.0,

    // Levels of detail of the drawn ground (island-world design section 1): 512 m chunks at full
    // detail within 700 m of the eye, every 2nd sample within 1.4 km, then 4, 8, 16, and 32 past
    // 11.2 km (about 1 degree a quad at every ring). The chunks are the leaves of a quadtree whose
    // roots are 8 km squares (16 x 16 chunks): a node is one mesh of 64 x 64 quads at step
    // 2^level, split only where the eye is near, so the whole island is about 90 ground meshes
    // (owner, 2026-10-24: "make sure to lower draw calls").
    terrain_lod: (
        chunk_cells: 64,
        ring_m: [700.0, 1400.0, 2800.0, 5600.0, 11200.0],
        hysteresis_m: 64.0,
        collider_radius_m: 400.0,
        builds_per_frame: 6,
        max_level: 4,
    ),

    // How far the pilot sees (island-world design section 5).
    view: (
        far_m: 40000.0,
        // The scattering sky hazes the distance itself (sky-atmosphere); the flat fog stays thin.
        clear_visibility_m: 20000.0,
        exposure_ev100: 13.4,
        // The sun disk 2 degrees across (the real 0.53 reads as a dot), twice as bright.
        sun_disk_deg: 2.0,
        sun_disk_intensity: 2.0,
        // The colour grade (owner, 2026-10-24: "Some colour balance maybe? ... Make scene a little
        // more vibrant"): 15 % more saturation and a touch more contrast. White balance stays
        // neutral: 0.06 warmer turned the whole street pink and the glass purple (lavapipe stills,
        // 2026-10-24), Bevy's temperature is far stronger than its size suggests.
        grade_saturation: 1.15,
        grade_contrast: 1.08,
        grade_temperature: 0.0,
        // Screen-space ambient occlusion on the world (openspec/changes/ambient-occlusion; owner,
        // 2026-10-24: "Ssao? Might help"): creases and contact points darken in indirect light.
        // 1.5 m reaches across a desk; 0 switches it off.
        ssao_radius_m: 1.5,
        ssao_quality: Medium,
        // GPU occlusion culling on the pilot's eye (openspec/changes/occlusion-culling): what is
        // hidden behind the street's buildings is not drawn. CB_NO_OCCLUSION=1 switches it off.
        occlusion_culling: true,
    ),

    // Rivers, lakes and waterfalls (openspec/changes/hydrology/design.md). Water drains over a
    // 128 m grid: snowmelt above the range's snowline, a twelfth as much rain below it, summed
    // downhill; 12 snow cells' worth makes a stream 10 m wide, which widens by the square root of its
    // flow to 56 m. Basins 8 m deep and 16 cells wide that a stream feeds are lakes, the ten largest
    // (owner, 2026-10-25: "too many lakes"). A river that drops 12 m in one
    // 16 m step (a cliff, not a steep slope) for 25 m or more is a waterfall, with a plunge pool under it.
    water: (
        // No rivers for now, and nothing carved for them: the sea and the basin lakes stay (owner,
        // 2026-10-25: "delete all rivers", "they dont integrate well with the terrain", "I just want to turn off river
        // geometry, and river caving terrain", "lakes and oceans should work still"). `true` brings
        // back the rivers, their waterfalls, plunge pools and bridges.
        rivers: false,
        city_freeboard_m: 2.0,
        drainage_cell_m: 128.0,
        lowland_rain: 0.08,
        melt_band_m: 400.0,
        stream_min_flow: 12.0,
        stream_min_cells: 3,
        river_step_m: 16.0,
        river_city_clearance_m: 80.0,
        stream_half_width_m: 5.0,
        river_max_half_width_m: 28.0,
        river_depth_m: 7.0,
        freeboard_m: 2.0,
        bank_slope: 0.45,
        flow_m_s: 1.5,
        lake_min_depth_m: 8.0,
        lake_min_cells: 16,
        lake_max_count: 10,
        lake_radius_m: (70.0, 900.0),
        lake_depth_m: 14.0,
        lake_shore_wobble: 0.12,
        fall_step_m: 12.0,
        fall_min_height_m: 25.0,
        plunge_radius_per_m: 1.4,
    ),

    // Trees (openspec/changes/vegetation, grown by tile near the bodies: island-world design
    // section 3). The woods are as dense as before; only the tiles near the pilot and the mechs exist.
    // Denser, farther woods (owner, 2026-10-24: "More trees please", but "100k is probably a bit
    // much" as entities) wait for GPU-driven trees, placed and culled in a compute shader.
    // Drawn to 2 km (owner, 2026-10-24: "Trees should have max distance of 2km"): grown to 2.2 km,
    // let go past 2.7 km.
    trees: (
        tile_sites: 24,
        keep_radius_m: 2200.0,
        // Within 60 m of a body its trees grow at once; out to 400 m, 4 tiles a step (a body brought in somewhere new
        // wanted about 16 tiles in one step: the desktop's 36 ms tree stalls); beyond, 2 a step.
        urgent_radius_m: 400.0,
        must_radius_m: 60.0,
        urgent_tiles_per_step: 4,
        release_radius_m: 2700.0,
        tiles_per_step: 2,
        draw_radius_m: 2000.0,
    ),

    // Clouds (openspec/changes/cloud-weather): one camera-facing billboard a puff, lit as a sphere
    // by the scene's sun and sky, sorted back to front, faded where they meet the ground. Drawn
    // within 20 km of the eye, so storm towers and the front stand on the horizon; re-sorted when
    // the eye has moved 30 m through them. The wind blows from the west at 6 m/s: the west is wet,
    // the east in the rain shadow, and the whole sky drifts with it. To be measured on the owner's
    // hardware with CB_NO_CLOUDS against the same take.
    clouds: (
        wind_m_s: (6.0, 0.0),
        draw_radius_m: 20000.0,
        resort_m: 30.0,
        // Owner, 2026-10-25, on the first stills: "clouds are too white, they need some shadowing on
        // the bottom": less wrap, a darker base, and each puff shaded toward its own underside.
        look_wrap: 0.35,
        look_silver: 1.6,
        look_scattered: 0.2,
        look_albedo: 0.92,
        look_storm_albedo: 0.55,
        look_base_shade: 0.55,
        look_storm_base_shade: 0.85,
        // Owner, 2026-10-27: "Can we tint the dark parts of clouds softer? Some clouds look unnecessarily too dark on
        // the bottom": the shaded side gets this much of the sky's own colour back, times the albedo (0 the old look).
        look_shadow_floor: 0.35,
        look_near_fade_m: 140.0,
        look_erode: 0.62,
        look_soft_m: 60.0,
    ),

    // The weather (openspec/changes/cloud-weather/design.md section 2), ported from the island
    // mockup to the crater island. Positions are (x, z) metres: +x east, +z south. Bearings are
    // degrees from north toward east.
    weather: (
        // Fair cumulus on a 2 km grid over a disc out to 34 km, thinning from 24 km so the sky has
        // no edge; per tile 0.3 + 2.8 x moisture clusters over land, 0.5 at sea, 1.6 in the streets
        // south of the island; 28 % of wet clusters tower to 2.2-3.8 km, 45 % of the rest stay small.
        cumulus: (
            base_m: 600.0,
            tile_m: 2000.0,
            disc_m: 34000.0,
            thin_from_m: 24000.0,
            edge_noise_m: 2500.0,
            land_clusters: (0.3, 2.8),
            sea_clusters: 0.5,
            street_clusters: 1.6,
            streets_south_of_m: 6000.0,
            street_spacing_m: 2200.0,
            towering_share: 0.28,
            humilis_share: 0.45,
            towering_top_m: (2200.0, 3800.0),
            clear_of_front_m: 1500.0,
            dark: (0.08, 0.3),
        ),
        // A high over the sea to the south-east: clear within 6 km, cumulus back to full by 17 km.
        high: (centre_m: (17000.0, 12000.0), clear_m: 6000.0, edge_m: 17000.0),
        // Three storm cells in the wet west (the mockup's: over the jungle 6.5 km west of the spine,
        // at sea off the archipelago, and to the north-west): towers from 700 m to their tops, anvils blown 2.6
        // km downwind, scud under slate-grey bases, a rain shaft each, the ground darkened by 85 %
        // at the centre out to 1.6 x the tower's radius, its edge wandering 600 m.
        storms: (
            cells: [
                (centre_m: (-5887.0, -4186.0), radius_m: 2600.0, top_m: 9500.0),
                (centre_m: (-15500.0, 9500.0), radius_m: 3200.0, top_m: 10500.0),
                (centre_m: (-11000.0, -14000.0), radius_m: 1900.0, top_m: 6500.0),
            ],
            base_m: 700.0,
            ring_step_m: 260.0,
            anvil_puffs: 70,
            anvil_downwind_m: 2600.0,
            scud_puffs: 24,
            dark: (0.75, 0.15),
            shaft_share: 0.75,
            shaft_top_m: 720.0,
            shade_reach: 1.6,
            shade: 0.85,
            shade_wobble_m: 600.0,
        ),
        // A cold front off the west coast, lying south-west to north-east, 52 km long and 8.4 km
        // wide: layered grey cloud from 900 m to 2.8 km, a tower to 6.2 km every 6 km, a rain
        // shaft every 5 km.
        front: (
            centre_m: (-17000.0, -4000.0),
            along: (0.62, -0.78),
            length_m: 52000.0,
            half_width_m: 4200.0,
            step_m: 300.0,
            layer_m: (900.0, 2800.0),
            tower_every_m: 6000.0,
            tower_top_m: 6200.0,
            shaft_every_m: 5000.0,
            shaft_radius_m: 2200.0,
            shade_every_m: 10000.0,
            shade_radius_m: 6000.0,
            shade: 0.6,
        ),
        // The stratocumulus deck at sea to the north, behind the front, with breaks.
        deck: (
            count: 900,
            bearing_deg: (330.0, 400.0),
            distance_m: (14500.0, 21500.0),
            layer_m: (700.0, 1000.0),
            offshore_m: 600.0,
            break_wavelength_m: 4000.0,
            break_below: -0.45,
        ),
        // Cloud banked on the range's windward (west) flank: over ground above 500 m that rises 60 m
        // within 900 m downwind, no higher than 1.9 km.
        orographic: (
            count: 520,
            tries: 12000,
            search_m: 14000.0,
            min_ground_m: 500.0,
            rise_probe_m: 900.0,
            min_rise_m: 60.0,
            top_m: 1900.0,
        ),
        // Lenticular caps over up to five peaks above 1,900 m, 2.5 km apart.
        caps: (min_peak_m: 1900.0, spacing_m: 2500.0, most: 5, tries: 20000, search_m: 12000.0),
        // Small flat altocumulus at 3.3-3.7 km over the south-west.
        altocumulus: (centre_m: (-6000.0, 14000.0), radius_m: 11000.0, spacing_m: 450.0, layer_m: (3300.0, 3700.0)),
        // Cirrus streaks at 8.2-9.4 km on a 32 km disc.
        cirrus: (count: 90, disc_m: 32000.0, height_m: (8200.0, 9400.0), length_m: (5000.0, 14000.0), width_m: (500.0, 1400.0)),
        // Opacity by kind: cumulus, tower, anvil, layer (deck, front, scud), orographic, cap, altocumulus.
        opacity: (0.95, 1.0, 0.8, 0.8, 0.6, 0.9, 0.6),
        shaft_rain: 0.7,
    ),

    // Ground fog (openspec/changes/ground-fog): a layer densest at sea level, thinning by e every
    // 120 m up, worked out exactly along each view ray; level ground fades to half by about 8 km.
    // Mist (up to 5 x) pools in hollows 100 m below the ground 1.5 km round, within 300 m of water
    // and 600 m of the coast, never above 600 m. Under a storm's rain the eye's air thickens by
    // 1 / 1,500 m. Lit by the sky and by the sun scattered forward (a glow toward it).
    fog: (
        density_per_m: 0.0000833,
        // Aerial haze (openspec/changes/ground-fog design section 2a; owner, 2026-10-26: "we also
        // have more distance fog affecting at higher altitudes", "hieght fog"): 1 / 45,000 m at sea
        // level, thinning every 1.5 km, so far land and sea blue and soften from any height.
        haze_density_per_m: 0.0000222,
        haze_scale_height_m: 1500.0,
        scale_height_m: 120.0,
        mist_strength: 5.0,
        mist_top_m: 600.0,
        hollow_depth_m: 100.0,
        hollow_reach_m: 1500.0,
        water_reach_m: 300.0,
        coast_reach_m: 600.0,
        map_cell_m: 160.0,
        mist_taps_m: 6000.0,
        sky_length_m: 40000.0,
        rain_per_m: 0.000667,
        rain_reach_m: 1500.0,
        eye_weather_s: 1.5,
        storm_dim: 0.45,
        ambient_share: 1.0,
        sun_share: 0.25,
        phase_g: 0.6,
        // How thick it is (survey F1; owner, 2026-10-26: "Approve all"). On the world's clock
        // (`day_night.ron`, an hour every 120 s): the morning mist (twice the air, full mist) lies
        // from midnight and thins to the day's (plain air, half the mist) between 07:00 and 11:00,
        // the first 8 minutes of a world that starts at 07:00. A combat-heavy mission flies in
        // clear air (half the air, no mist) while it runs.
        presets: (
            morning: (density_scale: 2.0, mist_scale: 1.0),
            day: (density_scale: 1.0, mist_scale: 0.5),
            clear: (density_scale: 0.5, mist_scale: 0.0),
        ),
        burn_off_h: (7.0, 11.0),
        missions: {
            Defence: Clear,
            Fortress: Clear,
        },
    ),
    // Building frames (openspec/changes/structural-destruction): a member fails past
    // safety_factor x its intact load, after a creak; a floor bay held on one edge keeps 45 %.
    structure: (
        safety_factor: 2.0,
        creak_s: (0.5, 1.6),
        held_four: 1.0,
        held_three: 0.85,
        held_diagonal: 0.7,
        held_one_edge: 0.45,
        held_one: 0.25,
        held_hung: 0.4,
        // A 6 MJ shell at a column's foot breaks the columns within about 3 m (playtest 2026-10-24).
        column_hp_mj: 2.0,
        slab_hp_mj: 3.0,
        wall_hp_mj: 0.7,
        slab_kg_m2: 600.0,
        column_kg_m: 864.0,
        wall_kg_m2: 400.0,
        slab_m: 0.25,
        column_m: 0.6,
        wall_m: 0.3,
        // Falling parts and rubble (openspec/changes/rubble).
        impact_factor: 2.0,
        rubble_fines: 0.5,
        rubble_bulking: 1.4,
        repose_slope: 0.75,
        max_rubble_m: 18.0,
        rubble_spread_m: 4.0,
    ),
    // Building skins and roofs (openspec/changes/building-generation): the mockup's facade modules,
    // parapet and coping, roof props; only within dress_radius_m of the player.
    dressing: (
        parapet_m: 1.1,
        parapet_wall_m: 0.3,
        coping_m: 0.08,
        props_per_100m2: 1.0,
        max_props: 10,
        prop_edge_m: 1.2,
        // Only buildings this near the player are dressed; farther ones stay plain boxes (owner,
        // 2026-10-24: elements "only generate when a mech is near city or building").
        dress_radius_m: 250.0,
        // Rooms and furniture are drawn within 250 m of the pilot, hidden past 270 m, and cast no
        // shadows (openspec/changes/building-lod; owner, 2026-10-24: "I would prefer 250 m for
        // furniture").
        rooms_radius_m: 250.0,
        rooms_margin_m: 20.0,
        // Past the dressing, to 1.5 km, a building shows its massing (parapet, cornice, roof props
        // from its own dressing) over walls wearing its own type's facade; beyond, the walls alone
        // (openspec/changes/building-type-lods; owner, 2026-10-25: "for each building type we're
        // gonna need a custom LOD texture/mesh for them"). The massing gives way to the plain box at
        // 1.5 km (survey L2, owner 2026-10-26: "Approve all").
        massing_radius_m: 1500.0,
        massing_pieces: 16,
        massing_per_frame: 12,
        // A detail that shows is kept to 1.15 times its radius, so a building on the line does not flicker.
        keep_ratio: 1.15,
    ),
    // Street doors, stairs and the colliders a pilot on foot walks into
    // (openspec/changes/building-interiors; owner, 2026-10-25: "each building needs doors and
    // staairs that i as a player can walk into them").
    interiors: (
        // A dog-leg stair: risers no higher, treads no deeper (and never shallower) than these.
        stair_max_rise_m: 0.18,
        stair_max_run_m: 0.28,
        stair_min_run_m: 0.22,
        stair_width_m: 1.2,
        stair_landing_m: 1.3,
        stair_half_landing_m: 1.1,
        // Street doors: a walk-up's front door, an office's pair of lobby doors, a warehouse's
        // personnel door; clear height above the sill.
        front_door_w_m: 1.2,
        lobby_door_w_m: 1.9,
        personnel_door_w_m: 1.0,
        door_clear_h_m: 2.2,
        // Street doors swing open as you walk into them and shut behind you (survey W30): a pilot on
        // foot within 1.5 m of the leaf, either side, opens it away from them, 90 degrees in 0.45 s;
        // it stands open while they are in the doorway, then 1.5 s after they have gone, and shuts in
        // 1 s. Never past 90 degrees (the leaf would swing into the wall beside its jamb).
        door_open_deg: 90.0,
        door_open_deg_s: 200.0,
        door_close_deg_s: 90.0,
        door_close_delay_s: 1.5,
        door_trigger_m: 1.5,
        // On foot, anything this high or lower is stepped onto; anything starting below head height
        // is in the way.
        step_m: 0.45,
        head_m: 1.8,
        // Colliders only while on foot (owner, 2026-10-26), for buildings within 60 m of the pilot
        // (built at once within 12 m, the rest on a worker thread), freed past 80 m. Smaller than the
        // 150 m interior radius: a runner reaches a door 60 m away in 13 s, the job takes milliseconds.
        collision_radius_m: 60.0,
        collision_sync_m: 12.0,
        collision_margin_m: 20.0,
    ),
    // Physics debris (openspec/changes/debris-physics): chunks become rigid bodies only within
    // physics_radius_m of the pilot's eye (owner, 2026-10-24: "If the mech is too far away there
    // should be no physics sim"); farther they are a dust puff, and the cell simulation still
    // breaks the building. Bodies past 1.2 times the radius are made static where they are.
    // physics_radius_m: 0.0 switches debris physics off: every breaking piece is a dust puff.
    debris: (
        physics_radius_m: 400.0,
        freeze_factor: 1.2,
        max_dynamic: 600,
        max_kept: 2500,
    ),
    // Air bases (openspec/changes/air-bases); the rest of their placement is the code default. Each has a runway
    // (survey W45, owner 2026-10-26: "Add a real runway, about 1.5 to 2 km, to each base"): tried in front of the
    // apron, behind the hangars, then down either side, longest first, flattened to the base's ground.
    bases: (
        runway_m: (2000.0, 1500.0),
        runway_width_m: 45.0,
        runway_gap_m: 100.0,
        runway_step_m: 100.0,
        runway_max_cut_m: 45.0,
        runway_city_clear_m: 300.0,
    ),
)
