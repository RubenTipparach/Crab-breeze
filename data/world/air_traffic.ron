        strip_margin_m: 40.0,
        park_s: 30.0,
    ),
    avoid: (
        keep_clear_m: 2500.0,
    ),
    fall: (
        drag_per_s: 0.15,
        spin_deg_s: 25.0,
        wreck_pieces: 6,
    ),
