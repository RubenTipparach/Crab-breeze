// Civil air traffic (openspec/changes/civil-air-traffic, design sections 1-5). Sizes are the 1980s
// aircraft each kind is, measured, not guessed: the three airliners as modelled (below); a heavy freighter
// between a C-141 (51 m) and a C-5 (75.5 m); a four-seat light plane (a 172 is 8.3 m long, 11 m span);
// a light turbine helicopter (a 206 is 11.8 m over its 10.2 m rotor). Speeds are the island's: the
// routes are 4-30 km, so cruise is slow and low, well under an airliner's real 230 m/s at 10 km.
// First estimates, retuned from play.
(
    kinds: {
        // The three airliners (openspec/changes/airliner-models; owner, 2026-10-29: "approve all ... implement
        // airplanes!"), modelled by tools/blender/build_airliners.py from the NASA three-views in
        // docs/reference/airliner-blueprints/: each glb's manifest beside it gives its rest on its gear, its damage
        // zones (each a share of `hp`, broken away at zero) and its rig and lamps. Sizes are the models' measured ones
        // (the build checks them within 2 % of the real aircraft; heights are standing on the gear). LOD0, with the
        // cabin, within 250 m; LOD1 to 1.5 km; LOD2 beyond.
        "airliner": (
            // after the Boeing 720: an early four-jet narrowbody, 138 seats
            role: Airliner,
            length_m: 41.45,
            span_m: 40.05,
            height_m: 12.47,
            fuselage_m: 3.76,
            cruise_m_s: 120.0,
            approach_m_s: 70.0,
            climb_m_s: 12.0,
            descent_m_s: 9.0,
            turn_deg_s: 3.0,
            cruise_agl_m: 1100.0,
            max_near: 2,
            hp: 260.0,
            armour_mm: 4.0,
            crash_mj: 45.0,
            // the recorded airliner as it is (survey W49)
            engine: Some((sound: Turbofan, pitch: 1.0)),
            model: Some((
                scene: "models/aircraft/airliner.glb",
                lod_m: (250.0, 1500.0),
                gear_below_m: 250.0,
            )),
            tint: (0.86, 0.86, 0.84),
        ),
        "propliner": (
            // after the Douglas DC-3: a twin radial propliner on the short hops, a taildragger, 21 seats
            role: Airliner,
            length_m: 19.85,
            span_m: 29.15,
            height_m: 5.53,
            fuselage_m: 2.35,
            cruise_m_s: 75.0,
            approach_m_s: 38.0,
            climb_m_s: 5.0,
            descent_m_s: 4.5,
            turn_deg_s: 4.0,
            cruise_agl_m: 700.0,
            max_near: 2,
            hp: 120.0,
            armour_mm: 2.0,
            crash_mj: 12.0,
            // the recorded prop plane slowed toward two big radials
            engine: Some((sound: Propeller, pitch: 0.6)),
            model: Some((
                scene: "models/aircraft/propliner.glb",
                lod_m: (250.0, 1500.0),
                gear_below_m: 200.0,
            )),
            tint: (0.93, 0.93, 0.9),
        ),
        "widebody": (
            // after the Lockheed L-1011 TriStar: a three-engine wide-body on the longest routes, 306 seats
            role: Airliner,
            length_m: 54.35,
            span_m: 47.5,
            height_m: 16.18,
            fuselage_m: 5.97,
            cruise_m_s: 125.0,
            approach_m_s: 75.0,
            climb_m_s: 11.0,
            descent_m_s: 9.0,
            turn_deg_s: 2.5,
            cruise_agl_m: 1200.0,
            max_near: 1,
            hp: 420.0,
            armour_mm: 5.0,
            crash_mj: 80.0,
            // three bigger engines: the airliner's turbofans played a little slower
            engine: Some((sound: Turbofan, pitch: 0.9)),
            model: Some((
                scene: "models/aircraft/widebody.glb",
                lod_m: (250.0, 1500.0),
                gear_below_m: 250.0,
            )),
            tint: (0.95, 0.95, 0.94),
        ),
        "freighter": (
            role: Freighter,
            length_m: 70.0,
            span_m: 68.0,
            height_m: 19.0,
            fuselage_m: 8.0,
            cruise_m_s: 110.0,
            approach_m_s: 65.0,
            climb_m_s: 9.0,
            descent_m_s: 8.0,
            turn_deg_s: 2.5,
            cruise_agl_m: 900.0,
            max_near: 2,
            hp: 260.0,
            armour_mm: 5.0,
            crash_mj: 60.0,
            // four bigger engines: the airliner's turbofans played slower
            engine: Some((sound: Turbofan, pitch: 0.85)),
            // The modelled freighter (survey D8, W48), built by tools/blender/build_freighter.py: LOD0 within 400 m,
            // LOD1 to 1.5 km, LOD2 beyond; its gear down below 250 m over the ground; the air drop's sling and the hook
            // a bought mech hangs from (its SLING_hook node, checked by cb-tools validate).
            model: Some((
                scene: "models/aircraft/freighter.glb",
                lod_m: (400.0, 1500.0),
                gear_below_m: 250.0,
                sling: Some("models/aircraft/freighter_sling.glb"),
                sling_hook_m: (0.0, -12.9, 0.0),
            )),
            tint: (0.46, 0.50, 0.52),
        ),
        "light_plane": (
            role: LightPlane,
            length_m: 8.3,
            span_m: 11.0,
            height_m: 2.7,
            fuselage_m: 1.2,
            cruise_m_s: 55.0,
            approach_m_s: 33.0,
            climb_m_s: 4.0,
            descent_m_s: 5.0,
            turn_deg_s: 8.0,
            cruise_agl_m: 300.0,
            orbit_radius_m: (700.0, 1100.0),
            max_near: 2,
            hp: 30.0,
            armour_mm: 1.0,
            crash_mj: 2.0,
            // a recorded prop plane slowed toward a four-seater's two-blade propeller, about 80 Hz a blade
            engine: Some((sound: Propeller, pitch: 0.75)),
            tint: (0.92, 0.62, 0.18),
        ),
        "helicopter": (
            role: Helicopter,
            length_m: 12.0,
            span_m: 10.2,
            height_m: 3.4,
            fuselage_m: 1.6,
            cruise_m_s: 35.0,
            approach_m_s: 20.0,
            climb_m_s: 6.0,
            descent_m_s: 6.0,
            turn_deg_s: 12.0,
            cruise_agl_m: 180.0,
            orbit_radius_m: (350.0, 600.0),
            max_near: 2,
            hp: 40.0,
            armour_mm: 2.0,
            crash_mj: 3.0,
            // a recorded medium helicopter slowed toward a light one's slower rotor beat
            engine: Some((sound: Rotor, pitch: 0.7)),
            tint: (0.18, 0.30, 0.62),
        ),
        // The airfields' own kinds (openspec changes military-base and airfield-traffic; owner, 2026-10-30: "Civilian
        // airports should have some helicopters too", "Vehicles: helicopter, cargo plane, fighter jets"), modelled by
        // tools/blender/build_military_aircraft.py; sizes are the manifests' measured ones (heights standing on the
        // gear). They live on their field's stands and pads (max_near 0: never spawned in the air), leave them when
        // their turnaround `turn_s` is over and come back to them. The transport flies supply runs between the bases.
        "civil_helicopter": (
            // a light turbine helicopter on the civil airports' pads: it circles the nearest city and settles back
            role: Helicopter,
            length_m: 13.3,
            span_m: 11.0,
            height_m: 3.33,
            fuselage_m: 1.6,
            cruise_m_s: 40.0,
            approach_m_s: 20.0,
            climb_m_s: 6.0,
            descent_m_s: 6.0,
            turn_deg_s: 12.0,
            cruise_agl_m: 180.0,
            orbit_radius_m: (350.0, 600.0),
            max_near: 0,
            hp: 45.0,
            armour_mm: 2.0,
            crash_mj: 3.0,
            engine: Some((sound: Rotor, pitch: 0.75)),
            model: Some((
                scene: "models/aircraft/civil_helicopter.glb",
                lod_m: (120.0, 900.0),
                gear_below_m: 60.0,
            )),
            tint: (0.92, 0.92, 0.9),
            turn_s: 480.0,
        ),
        "fighter": (
            // a twin-tail fighter: it taxis out, patrols a circle over its base and lands
            role: Fighter,
            length_m: 19.85,
            span_m: 13.0,
            height_m: 5.72,
            fuselage_m: 1.8,
            cruise_m_s: 180.0,
            approach_m_s: 75.0,
            climb_m_s: 30.0,
            descent_m_s: 15.0,
            turn_deg_s: 10.0,
            cruise_agl_m: 600.0,
            orbit_radius_m: (3000.0, 5000.0),
            max_near: 0,
            hp: 90.0,
            armour_mm: 6.0,
            crash_mj: 15.0,
            engine: Some((sound: Turbofan, pitch: 1.3)),
            model: Some((
                scene: "models/aircraft/fighter.glb",
                lod_m: (150.0, 1500.0),
                gear_below_m: 250.0,
            )),
            tint: (0.42, 0.46, 0.44),
            turn_s: 600.0,
        ),
        "military_cargo": (
            // a high-wing four-turboprop transport with a rear ramp: supply runs between the bases
            role: Transport,
            length_m: 29.96,
            span_m: 40.55,
            height_m: 11.35,
            fuselage_m: 4.2,
            cruise_m_s: 95.0,
            approach_m_s: 50.0,
            climb_m_s: 8.0,
            descent_m_s: 7.0,
            turn_deg_s: 4.0,
            cruise_agl_m: 700.0,
            orbit_radius_m: (1500.0, 2500.0),
            max_near: 1,
            hp: 220.0,
            armour_mm: 5.0,
            crash_mj: 40.0,
            engine: Some((sound: Propeller, pitch: 0.55)),
            model: Some((
                scene: "models/aircraft/military_cargo.glb",
                lod_m: (250.0, 1500.0),
                gear_below_m: 250.0,
            )),
            tint: (0.40, 0.44, 0.38),
            turn_s: 900.0,
        ),
        "military_helicopter": (
            // a utility helicopter with stub wings: it patrols over its base and settles back on its pad
            role: Gunship,
            length_m: 17.6,
            span_m: 16.4,
            height_m: 4.3,
            fuselage_m: 2.2,
            cruise_m_s: 50.0,
            approach_m_s: 25.0,
            climb_m_s: 8.0,
            descent_m_s: 7.0,
            turn_deg_s: 14.0,
            cruise_agl_m: 200.0,
            orbit_radius_m: (400.0, 700.0),
            max_near: 0,
            hp: 70.0,
            armour_mm: 8.0,
            crash_mj: 6.0,
            engine: Some((sound: Rotor, pitch: 0.6)),
            model: Some((
                scene: "models/aircraft/military_helicopter.glb",
                lod_m: (150.0, 1200.0),
                gear_below_m: 60.0,
            )),
            tint: (0.36, 0.40, 0.33),
            turn_s: 480.0,
        ),
    },
    near: (
        spawn_far_m: 10000.0,
        spawn_near_m: 3000.0,
        view_half_deg: 75.0,
        despawn_m: 14000.0,
        check_s: 4.0,
    ),
    routes: (
        glide_deg: 3.0,
        final_m: 4000.0,
        climb_out_m: 150.0,
        min_clear_m: 120.0,
        // Airliners and freighters take off from and land on each base's runway, 1.5 to 2 km (survey W45; the
        // runways are `bases` in world.ron): the roll starts and touchdown comes this far in from its end.
        strip_margin_m: 40.0,
        park_s: 30.0,
        // On the ground (airfield-traffic): taxiing and pushing back, waiting at the holding point before the runway is
        // free, stands filled within 6 km of the pilot, a patrol's length and circle, and a helicopter's lift off its pad.
        taxi_m_s: 8.0,
        pushback_m_s: 1.5,
        hold_s: 10.0,
        stand_fill_m: 6000.0,
        patrol_s: 1200.0,
        patrol_radius_m: 5000.0,
        lift_m: 60.0,
        lift_m_s: 3.0,
    ),
    avoid: (
        keep_clear_m: 2500.0,
    ),
    fall: (
        drag_per_s: 0.15,
        spin_deg_s: 25.0,
        wreck_pieces: 6,
    ),
)
