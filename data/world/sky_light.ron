// The sky's light and the window glass (openspec/changes/glass-reflections). Every field is the
// code default written out (crates/cb-core/src/sky_light.rs); omit one to inherit it, a zero is a
// zero.
(
    // The cached sky: Poly Haven's kloofendal_48d_partly_cloudy_puresky (CC0), sun clamped out and
    // a ground tone below the horizon, baked to a cube by tools/textures/gen_sky_cube.py. Its mean
    // sky radiance is 0.453 and its ground 0.104 (the tool prints them), so 2000 cd/m2 a unit puts
    // the open sky near 900 cd/m2, the flat ambient's old brightness. Empty turns it off.
    cube: "textures/sky/sky_cube.hdr",
    sky_cd_m2: 2000.0,
    yaw_deg: 0.0,
    // The flat fill kept under the sky light, and the old flat ambient used without it.
    ambient_cd_m2: 250.0,
    ambient_without_sky_cd_m2: 900.0,
    // Window glass: premultiplied, so its reflections are added in full and only what is behind
    // is dimmed by alpha. Reflectance 0.9 is about 13 % at normal incidence (coated tower glass;
    // 0.5 is plain 4 % glass); Fresnel takes it toward a mirror at grazing angles. Alpha 0.55
    // shows the rooms at 45 %: glass reads as a mirror only where what is behind it is darker
    // than the street (alpha 0.3 first: the rooms, lit like the street, drowned the reflection).
    // Tinted (owner, 2026-10-24: "usually glass is tinted"); then mirror-coated (owner: "glass
    // still doesnt look right, too transparent", "it should go harder on the reflections"). Plain
    // glass reflects at most 16 % head-on, so the coating (Bevy's metallic) carries it: about
    // 0.9 x 0.48 + 0.1 x 0.16 = 45 % head-on, blue-grey, toward a mirror at grazing angles. Alpha
    // 0.88 lets 12 % of the room through; the body colour left is 0.1 x tint, a dark blue.
    glass: (
        tint: (0.4, 0.5, 0.55),
        alpha: 0.88,
        roughness: 0.02,
        reflectance: 1.0,
        coating: 0.9,
    ),
)
