// How the water looks, above and below, and the water on the glass after surfacing
// (openspec/changes/water-rendering/design.md section 4). Every field is the code default written
// out (crates/cb-core/src/water_look.rs); omit one to inherit it, a zero is a zero. Units are in
// the keys or the Rust docs. Ported from Pale Blue Dot's water.ron and weather.ron (db25fe2);
// where a value differs the design says why.
(
    // The surface.
    time_scale: 0.75,
    ripple_scale_per_m: 0.6,
    ripple_speed: 1.0,
    ripple_steepness: 0.45,
    slope_max: 0.7,
    detail_fade: 4.0,
    flow_period_s: 4.0,
    // The swell, in the normals only (the surface stays at the simulation's height).
    swell_wavelength_m: (60.0, 23.0, 9.0),
    swell_height_m: (0.35, 0.12, 0.05),
    swell_heading_deg: (20.0, 75.0, -40.0),

    // Looking in: refraction and absorption (survey WR1: clearer than Pale Blue Dot's 0.90, 0.25, 0.08).
    refract_amount: 0.04,
    refract_max_uv: 0.03,
    max_path_m: 200.0,
    light_falloff: 1.0,
    // A dark open sea and teal shallows (openspec/changes/water-look design section 0; owner,
    // 2026-10-26: "I want water to look realistic"): absorption near pure water's (Pope and Fry
    // 1997) with a little coastal matter, so sand shows teal through 2-10 m; the deep body returns
    // about 1 % of red-green and 4 % of blue (navy), and the reflected sky carries the look.
    absorption_per_m: (0.32, 0.035, 0.012),
    deep_color: (0.004, 0.018, 0.040),
    // Teal in the shallows, easing to the deep colour by 14 m of water (coastal water scatters green
    // as well as blue; seen at a slant the light alone strips the green and leaves cobalt).
    shallow_color: (0.020, 0.090, 0.075),
    shallow_depth_m: 14.0,

    // The sky mirrored (its horizon is the game's sky colour).
    // The game's sky deepened toward the zenith (it was a saturated constant the sea mirrored from the air).
    sky_zenith_color: (0.16, 0.30, 0.56),
    // Water reflects most at a grazing angle, which greys a real sea toward its horizon (0.22 left it black).
    sky_horizon_strength: 0.7,

    // Foam.
    foam_color: (0.95, 0.97, 1.0),
    foam_intensity: 0.10,
    foam_crest: (0.35, 0.60),
    foam_crest_weight: 0.55,
    foam_slope: (0.50, 1.20),
    foam_slope_weight: 0.26,
    shore_foam_m: 1.5,
    shore_foam_weight: 0.6,

    // The sun's glint.
    specular_intensity: 0.06,
    specular_power: 140.0,
    sun_tint: (1.10, 1.15, 1.20),

    // Under water and surfacing.
    underwater_distortion: 0.0015,
    wet_blur: 0.02,
    partial_band_m: 0.8,
    emerge_dry_s: 2.6,
    cabin_dry_radius_m: 2.5,

    // The drops on the glass (Pale Blue Dot's rain_lens_*). Rain stays off until weather exists.
    lens_density: 1.4,
    lens_refract: 1.7,
    lens_speed: 1.0,
    lens_size: 0.7,
    lens_scale: 2.0,
    lens_rain: 0.0,
    // Seated, the drops lie on each window pane: metres of pane to one unit of the drop pattern
    // (about the screen height a pane a metre away fills at the 85 degree view).
    lens_pane_m: 1.8,
    // Rain on the glass flying through cloud (openspec/changes/cloud-rain): drops at up to this
    // strength at a cloud's heart, wetting through in cloud_wet_s and clearing in cloud_dry_s.
    cloud_rain: 0.85,
    cloud_wet_s: 1.2,
    cloud_dry_s: 4.0,
)
