   "node_position": {
    "x": 880,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "grain",
      "longdesc": "grain",
      "name": "grain",
      "shortdesc": "grain",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat height_$name(vec2 uv) {\n\tfloat f = fract(uv.y * 12.0);\n\tfloat slat = 0.15 + 0.8 * (1.0 - f) - 0.12 * pow(1.0 - f, 6.0);\n\treturn mix(0.03, slat, smoothstep(0.0, 0.07, f)) + 0.012 * $grain(uv);\n}\nvec3 albedo_$name(vec2 uv) {\n\tfloat f = fract(uv.y * 12.0);\n\tfloat v = 0.86 + 0.03 * ($grain(uv) - 0.5) + 0.02 * ($fine(uv) - 0.5);\n\tv *= 0.95 + 0.07 * $lo(uv);\n\tv = mix(0.3, v, smoothstep(0.0, 0.05, f));\n\treturn vec3(v, v * 0.995, v * 0.98);\n}\nfloat rough_$name(vec2 uv) { return 0.52 + 0.08 * $fine(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house shutter",
    "name": "house shutter",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house shutter"
   },
