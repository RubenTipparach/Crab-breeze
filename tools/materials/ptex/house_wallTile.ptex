  {
   "name": "shader_3",
   "node_position": {
    "x": 880,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nvec4 cell_$name(vec2 uv) { vec2 p = uv * 9.0; return vec4(fract(p) / 9.0, mod(floor(p), 9.0)); }\nfloat edge_$name(vec2 uv) { vec4 c = cell_$name(uv); float s = 1.0 / 9.0; return min(min(c.x, s - c.x), min(c.y, s - c.y)) - 0.001; }\nfloat height_$name(vec2 uv) {\n\tfloat d = edge_$name(uv);\n\treturn mix(0.15 + 0.05 * $fine(uv), 0.88 + 0.04 * ($mid(uv) - 0.5), smoothstep(0.0, 0.004, d));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tfloat v = 0.93 * (0.975 + 0.04 * hs_$name(c.zw)) * (0.985 + 0.02 * $mid(uv));\n\tfloat grout = 0.66 * (0.9 + 0.15 * $fine(uv)) * (0.92 + 0.1 * $lo(uv));\n\tfloat t = mix(grout, v, smoothstep(0.0, 0.0008, edge_$name(uv)));\n\treturn vec3(t, t, t * 0.99);\n}\nfloat rough_$name(vec2 uv) { return mix(0.85, 0.1 + 0.05 * $mid(uv), smoothstep(0.0, 0.0008, edge_$name(uv))); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house wall tile",
    "name": "house wall tile",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house wall tile"
   },
   "type": "shader"
  },
