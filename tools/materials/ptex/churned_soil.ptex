  {
   "name": "shader_3",
   "node_position": {
    "x": 880,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "clods",
      "longdesc": "clods",
      "name": "clods",
      "shortdesc": "clods",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "detail",
      "longdesc": "detail",
      "name": "detail",
      "shortdesc": "detail",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "warp",
      "longdesc": "warp",
      "name": "warp",
      "shortdesc": "warp",
      "type": "f"
     }
    ],
    "instance": "\nfloat dome_$name(vec2 uv) { return (1.0 - smoothstep(0.0, 0.7, $clods(uv))) * smoothstep(0.25, 0.65, $warp(uv) + 0.3 * $detail(uv)); }\nfloat height_$name(vec2 uv) { return 0.55 * dome_$name(uv) + 0.3 * $detail(uv) + 0.15 * $warp(uv); }\nvec4 albedo_$name(vec2 uv) {\n\tfloat dm = dome_$name(uv);\n\tfloat d = $detail(uv);\n\tvec3 c = mix(vec3(0.075, 0.058, 0.042), vec3(0.24, 0.185, 0.13), 0.45 * dm + 0.55 * d);\n\tc *= mix(0.8, 1.1, $warp(uv));\n\treturn vec4(c, 1.0);\n}\n",
    "longdesc": "churned soil",
    "name": "churned soil",
    "outputs": [
     {
      "f": "height_$name($uv)",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "albedo_$name($uv)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "0.92 - 0.08 * dome_$name($uv)",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "churned soil"
   },
   "type": "shader"
  },
