   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "gran",
      "longdesc": "gran",
      "name": "gran",
      "shortdesc": "gran",
      "type": "f"
     },
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "granc",
      "longdesc": "granc",
      "name": "granc",
      "shortdesc": "granc",
      "type": "rgb"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nvec4 cell_$name(vec2 uv) {\n\tfloat row = floor(uv.y * 8.0);\n\tfloat x = uv.x * 3.0 + 0.5 * mod(row, 2.0);\n\treturn vec4(fract(x), fract(uv.y * 8.0), mod(floor(x), 3.0), mod(row, 8.0));\n}\nfloat slot_$name(vec2 uv) { vec4 c = cell_$name(uv); float d = min(c.x, 1.0 - c.x) / 3.0; return 1.0 - smoothstep(0.0025, 0.0035, d); }\nfloat height_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tfloat f = c.y;\n\tfloat tab = 0.3 + 0.62 * (1.0 - f);\n\tfloat h = mix(0.3, tab, smoothstep(0.0, 0.035, f));\n\th += 0.08 * smoothstep(0.0, 0.4, $gran(uv)) + 0.03 * $fine(uv);\n\treturn mix(h, 0.15 + 0.04 * $fine(uv), slot_$name(uv));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tfloat t = 0.94 + 0.13 * hs_$name(c.zw + 1.7);\n\tfloat gr = $granc(uv).r;\n\tfloat v = mix(0.4, 0.76, gr) * t;\n\tif ($granc(uv).g > 0.93) { v = 0.25; }\n\tv *= 0.94 + 0.1 * $mid(uv) + 0.06 * ($lo(uv) - 0.5);\n\tv = mix(v, 0.22, 0.85 * slot_$name(uv));\n\tv *= mix(0.8, 1.0, smoothstep(0.0, 0.05, c.y));\n\treturn vec3(v, v * 0.985, v * 0.97);\n}\nfloat rough_$name(vec2 uv) { return 0.88 + 0.08 * $granc(uv).b; }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house shingle",
    "name": "house shingle",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house shingle"
   },
