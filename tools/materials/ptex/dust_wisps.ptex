   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "n",
      "longdesc": "n",
      "name": "n",
      "shortdesc": "n",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "n2",
      "longdesc": "n2",
      "name": "n2",
      "shortdesc": "n2",
      "type": "f"
     }
    ],
    "instance": "float h_$name(float x) { return fract(sin(x * 12.9898 + 0.731) * 43758.5453); }\n\nvec2 cell_$name(vec2 uv) { return floor(uv * 4.0); }\nvec2 local_$name(vec2 uv) { return fract(uv * 4.0); }\nfloat edge_$name(vec2 uv) { vec2 c = local_$name(uv) - vec2(0.5); return smoothstep(0.5, 0.43, max(abs(c.x), abs(c.y))); }\n\nvec4 dust_$name(vec2 uv) {\n\tvec2 cl = cell_$name(uv);\n\tvec2 c = local_$name(uv) - vec2(0.5);\n\tfloat id = cl.x + cl.y * 4.0;\n\tfloat ang = (h_$name(id) - 0.5) * 0.6;\n\tvec2 q = vec2(c.x * cos(ang) - c.y * sin(ang), c.x * sin(ang) + c.y * cos(ang));\n\tfloat mask = 1.0 - smoothstep(0.15, 0.46, length(q * vec2(0.85, 1.6)));\n\tfloat v = $n(uv);\n\tfloat a = smoothstep(0.42, 0.72, v * 0.8 + mask * 0.55) * mask;\n\ta *= mix(0.7, 1.0, $n2(uv)) * edge_$name(uv);\n\treturn vec4(vec3(0.86, 0.81, 0.73) * mix(0.82, 1.04, v), clamp(a, 0.0, 1.0));\n}\n",
    "longdesc": "dust wisps",
    "name": "dust wisps",
    "outputs": [
     {
      "longdesc": "out0",
      "rgba": "dust_$name($uv)",
      "shortdesc": "out0",
      "type": "rgba"
     },
     {
      "f": "dust_$name($uv).a",
      "longdesc": "out1",
      "shortdesc": "out1",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "dust wisps"
   },
   "type": "shader"
  },
