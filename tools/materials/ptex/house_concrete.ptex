     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "n64",
      "longdesc": "n64",
      "name": "n64",
      "shortdesc": "n64",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "hole",
      "longdesc": "hole",
      "name": "hole",
      "shortdesc": "hole",
      "type": "f"
     },
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "holec",
      "longdesc": "holec",
      "name": "holec",
      "shortdesc": "holec",
      "type": "rgb"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "crack",
      "longdesc": "crack",
      "name": "crack",
      "shortdesc": "crack",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat bug_$name(vec2 uv) { return smoothstep(0.09, 0.04, $hole(uv)) * step(0.82, $holec(uv).b); }\nfloat crack_$name(vec2 uv) {\n\tfloat w = 1.0 - smoothstep(0.0, 0.012, $crack(uv + 0.02 * vec2($mid(uv) - 0.5, $n64(uv) - 0.5)));\n\treturn w * smoothstep(0.55, 0.7, $lo(uv + vec2(0.3, 0.6)));\n}\nfloat height_$name(vec2 uv) {\n\treturn 0.55 + 0.2 * ($n64(uv) - 0.5) + 0.18 * ($fine(uv) - 0.5) - 0.35 * bug_$name(uv) - 0.2 * crack_$name(uv);\n}\nvec3 albedo_$name(vec2 uv) {\n\tfloat v = 0.78 + 0.07 * ($lo(uv) - 0.5) + 0.06 * ($mid(uv) - 0.5) + 0.05 * ($fine(uv) - 0.5);\n\tv *= 1.0 - 0.1 * smoothstep(0.58, 0.75, $lo(uv + vec2(0.5, 0.1)));\n\tv += 0.04 * smoothstep(0.74, 0.82, $fine(uv * 2.0 + vec2(0.2, 0.7)));\n\tv -= 0.1 * smoothstep(0.7, 0.82, $fine(uv * 2.0 + vec2(0.6, 0.3)));\n\tv *= 1.0 - 0.4 * bug_$name(uv) - 0.25 * crack_$name(uv);\n\treturn vec3(v, v * 0.99, v * 0.955);\n}\nfloat rough_$name(vec2 uv) { return 0.88 + 0.07 * $fine(uv) - 0.04 * $lo(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house concrete",
    "name": "house concrete",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
