  {
   "name": "shader_4",
   "node_position": {
    "x": 1100,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "warp",
      "longdesc": "warp",
      "name": "warp",
      "shortdesc": "warp",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fibre",
      "longdesc": "fibre",
      "name": "fibre",
      "shortdesc": "fibre",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "pore",
      "longdesc": "pore",
      "name": "pore",
      "shortdesc": "pore",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat late_$name(vec2 uv) {\n\tfloat ring = fract(uv.y * 22.0 + 2.0 * $warp(uv) + 0.25 * $warp(uv * 4.0 + vec2(0.5)));\n\treturn smoothstep(0.62, 0.86, ring) * (1.0 - smoothstep(0.9, 1.0, ring));\n}\nfloat height_$name(vec2 uv) {\n\treturn 0.45 + 0.3 * late_$name(uv) + 0.12 * $fibre(uv) - 0.08 * smoothstep(0.78, 0.9, $pore(uv));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec3 c = vec3(0.76, 0.70, 0.645);\n\tc *= 1.0 - 0.24 * late_$name(uv);\n\tc *= 0.93 + 0.1 * $fibre(uv) + 0.06 * ($lo(uv) - 0.5);\n\tc *= 1.0 - 0.12 * smoothstep(0.78, 0.9, $pore(uv));\n\treturn c;\n}\nfloat rough_$name(vec2 uv) { return 0.58 + 0.08 * $fibre(uv) - 0.06 * late_$name(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house wood",
    "name": "house wood",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house wood"
   },
   "type": "shader"
  },
