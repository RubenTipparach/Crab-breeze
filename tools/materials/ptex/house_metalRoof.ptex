  {
   "name": "shader_4",
   "node_position": {
    "x": 1100,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "streak",
      "longdesc": "streak",
      "name": "streak",
      "shortdesc": "streak",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat ds_$name(vec2 uv) { float xs = fract(uv.x * 2.0) * 0.5; return min(xs, 0.5 - xs); }\nfloat seam_$name(vec2 uv) { return smoothstep(0.0075, 0.004, ds_$name(uv)); }\nfloat height_$name(vec2 uv) {\n\tfloat d = ds_$name(uv);\n\tfloat pan = 0.1 + 0.05 * ($lo(uv) - 0.5) + 0.06 * exp(-pow((d - 0.1667) / 0.004, 2.0)) + 0.06 * exp(-pow((d - 0.3333) / 0.004, 2.0));\n\tfloat top = 1.0 - 0.15 * smoothstep(0.0, 0.004, d);\n\treturn mix(pan, top, seam_$name(uv)) + 0.004 * $fine(uv);\n}\nvec3 albedo_$name(vec2 uv) {\n\tfloat v = 0.82 + 0.03 * ($mid(uv) - 0.5);\n\tv *= 1.0 - 0.07 * smoothstep(0.5, 0.8, $streak(uv));\n\tv += 0.02 * smoothstep(0.4, 0.9, $lo(uv + vec2(0.3, 0.5)));\n\tv += 0.03 * seam_$name(uv);\n\treturn vec3(v, v * 1.0, v * 1.005);\n}\nfloat rough_$name(vec2 uv) { return 0.4 + 0.08 * smoothstep(0.45, 0.8, $streak(uv)) + 0.04 * $mid(uv); }\nfloat metal_$name(vec2 uv) { return 0.6 - 0.04 * smoothstep(0.4, 0.9, $lo(uv + vec2(0.3, 0.5))); }\n",
    "longdesc": "house metal roof",
    "name": "house metal roof",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house metal roof"
   },
