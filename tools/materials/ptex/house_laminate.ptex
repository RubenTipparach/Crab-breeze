   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fl",
      "longdesc": "fl",
      "name": "fl",
      "shortdesc": "fl",
      "type": "f"
     },
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "flc",
      "longdesc": "flc",
      "name": "flc",
      "shortdesc": "flc",
      "type": "rgb"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat fleck_$name(vec2 uv) { return smoothstep(0.32, 0.22, $fl(uv)) * step(0.7, $flc(uv).r); }\nfloat height_$name(vec2 uv) { return 0.5 + 0.5 * ($fine(uv) - 0.5); }\nvec3 albedo_$name(vec2 uv) {\n\tvec3 c = vec3(0.9, 0.885, 0.85) * (0.98 + 0.03 * $lo(uv));\n\tvec3 f = mix(vec3(0.55, 0.54, 0.52), vec3(0.74, 0.66, 0.55), $flc(uv).g);\n\treturn mix(c, f, fleck_$name(uv));\n}\nfloat rough_$name(vec2 uv) { return 0.3 + 0.05 * $lo(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house laminate",
    "name": "house laminate",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house laminate"
   },
