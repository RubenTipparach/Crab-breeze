   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "heather",
      "longdesc": "heather",
      "name": "heather",
      "shortdesc": "heather",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "slubx",
      "longdesc": "slubx",
      "name": "slubx",
      "shortdesc": "slubx",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "sluby",
      "longdesc": "sluby",
      "name": "sluby",
      "shortdesc": "sluby",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat over_$name(vec2 uv) { vec2 c = floor(uv * 128.0); return mod(c.x + c.y, 2.0); }\nfloat height_$name(vec2 uv) {\n\tvec2 f = fract(uv * 128.0);\n\tfloat warp = sin(3.14159 * f.x) * (0.55 + 0.45 * sin(3.14159 * f.y));\n\tfloat weft = sin(3.14159 * f.y) * (0.55 + 0.45 * sin(3.14159 * f.x));\n\treturn 0.15 + 0.8 * mix(weft, warp, over_$name(uv));\n}\nvec3 albedo_$name(vec2 uv) {\n\tfloat o = over_$name(uv);\n\tfloat v = mix(0.8 + 0.08 * ($sluby(uv) - 0.5), 0.86 + 0.08 * ($slubx(uv) - 0.5), o);\n\tv *= 0.93 + 0.1 * $heather(uv) + 0.04 * ($lo(uv) - 0.5);\n\tvec2 f = fract(uv * 128.0);\n\tv *= 0.82 + 0.18 * sin(3.14159 * mix(f.y, f.x, o));\n\treturn vec3(v, v * 0.98, v * 0.96);\n}\nfloat rough_$name(vec2 uv) { return 0.9; }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house fabric",
    "name": "house fabric",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house fabric"
