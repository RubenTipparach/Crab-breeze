  {
   "name": "shader_8",
   "node_position": {
    "x": 220,
    "y": 160
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "lo2",
      "longdesc": "lo2",
      "name": "lo2",
      "shortdesc": "lo2",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "st",
      "longdesc": "st",
      "name": "st",
      "shortdesc": "st",
      "type": "f"
     },
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "stc",
      "longdesc": "stc",
      "name": "stc",
      "shortdesc": "stc",
      "type": "rgb"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "crack",
      "longdesc": "crack",
      "name": "crack",
      "shortdesc": "crack",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "crack2",
      "longdesc": "crack2",
      "name": "crack2",
      "shortdesc": "crack2",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "oil",
      "longdesc": "oil",
      "name": "oil",
      "shortdesc": "oil",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat stone_$name(vec2 uv) { return smoothstep(0.06, 0.24, $st(uv)) * step(0.4, $stc(uv).g); }\nvec2 wob_$name(vec2 uv) { return 0.006 * vec2($mid(uv) - 0.5, $mid(uv + vec2(0.37, 0.61)) - 0.5); }\n// Distance-like measure to the crack network (in tile units), long cracks and a finer branch network.\nfloat cd_$name(vec2 uv) { return min($crack(uv + wob_$name(uv)), 1.6 * $crack2(uv + 0.7 * wob_$name(uv))); }\n// How much of the tile has cracks at all: broad patches of cracked and sound road.\nfloat crackzone_$name(vec2 uv) { return smoothstep(0.45, 0.62, $lo2(uv + vec2(0.3, 0.1))); }\n// The open crack itself, about 4 mm.\nfloat crack_$name(vec2 uv) { return (1.0 - smoothstep(0.0, 0.0012, cd_$name(uv))) * crackzone_$name(uv); }\n// The tar seal over it, about 12 mm, on most of the network (left open where the sealing skipped).\nfloat seal_$name(vec2 uv) {\n\tfloat on = step(0.35, $lo(uv * 1.0 + vec2(0.5, 0.2)));\n\treturn (1.0 - smoothstep(0.0025, 0.0038, cd_$name(uv))) * crackzone_$name(uv) * on;\n}\nfloat oil_$name(vec2 uv) { return smoothstep(0.68, 0.78, $oil(uv)) * 0.8; }\nfloat height_$name(vec2 uv) {\n\tfloat h = 0.45 + 0.28 * sqrt(stone_$name(uv)) + 0.14 * ($fine(uv) - 0.5);\n\th -= 0.4 * crack_$name(uv) * (1.0 - seal_$name(uv));\n\th = mix(h, 0.5 + 0.03 * $fine(uv), seal_$name(uv));\n\treturn h;\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec3 bind = vec3(0.30, 0.30, 0.305) * (0.85 + 0.3 * $fine(uv));\n\tvec3 st = mix(vec3(0.44, 0.43, 0.42), vec3(0.62, 0.60, 0.57), $stc(uv).r);\n\tfloat wear = 0.5 + 0.5 * $lo(uv + vec2(0.13, 0.71));\n\tvec3 c = mix(bind, st, (0.55 + 0.35 * wear) * stone_$name(uv));\n\tc *= 0.8 + 0.32 * $lo(uv) + 0.12 * ($lo2(uv) - 0.5) + 0.05 * ($mid(uv) - 0.5);\n\tc *= 1.0 - 0.5 * crack_$name(uv) * (1.0 - seal_$name(uv));\n\tc = mix(c, vec3(0.07, 0.07, 0.075), 0.92 * seal_$name(uv));\n\tc = mix(c, c * vec3(0.45, 0.44, 0.42), oil_$name(uv));\n\treturn c;\n}\nfloat rough_$name(vec2 uv) {\n\tfloat r = 0.92 - 0.1 * stone_$name(uv) + 0.04 * $fine(uv);\n\tr = mix(r, 0.45, seal_$name(uv));\n\treturn mix(r, 0.55, oil_$name(uv));\n}\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "road asphalt",
    "name": "road asphalt",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "road asphalt"
   },
   "type": "shader"
  },
