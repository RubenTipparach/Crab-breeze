  {
   "name": "shader_5",
   "node_position": {
    "x": 1320,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "pore",
      "longdesc": "pore",
      "name": "pore",
      "shortdesc": "pore",
      "type": "f"
     },
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "porec",
      "longdesc": "porec",
      "name": "porec",
      "shortdesc": "porec",
      "type": "rgb"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "chip",
      "longdesc": "chip",
      "name": "chip",
      "shortdesc": "chip",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nvec4 cell_$name(vec2 uv) {\n\tfloat row = floor(uv.y * 4.0);\n\tfloat x = uv.x * 2.0 + 0.5 * mod(row, 2.0);\n\treturn vec4(fract(x) * 0.4, fract(uv.y * 4.0) * 0.2, mod(floor(x), 2.0), mod(row, 4.0));\n}\nfloat edge_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\treturn min(min(c.x, 0.4 - c.x), min(c.y, 0.2 - c.y)) - 0.005 - 0.0015 * ($chip(uv) - 0.5);\n}\nfloat pores_$name(vec2 uv) { return smoothstep(0.16, 0.06, $pore(uv)) * step(0.55, $porec(uv).r); }\nfloat height_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tfloat face = 0.8 + 0.05 * (hs_$name(c.zw) - 0.5) + 0.06 * ($fine(uv) - 0.5) + 0.04 * ($mid(uv) - 0.5) - 0.22 * pores_$name(uv);\n\t// A tooled concave joint: deepest in the middle.\n\tfloat d = edge_$name(uv);\n\tfloat joint = 0.32 - 0.12 * smoothstep(-0.005, 0.0, -abs(d + 0.005) + 0.005) + 0.06 * $fine(uv * 2.0);\n\treturn mix(joint, face, smoothstep(-0.0005, 0.0025, d));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tvec3 b = vec3(0.80, 0.79, 0.765) * (0.96 + 0.06 * hs_$name(c.zw + 2.0));\n\tb *= 0.92 + 0.12 * $mid(uv);\n\tb *= 1.0 - 0.18 * smoothstep(0.62, 0.78, $fine(uv + vec2(0.13, 0.41)));\n\tb *= 1.0 + 0.1 * smoothstep(0.66, 0.8, $fine(uv * 2.0 + vec2(0.5, 0.0)));\n\tb *= 1.0 - 0.4 * pores_$name(uv);\n\tvec3 mortar = vec3(0.74, 0.73, 0.70) * (0.88 + 0.16 * $fine(uv * 2.0));\n\treturn mix(mortar, b, smoothstep(-0.0004, 0.0015, edge_$name(uv))) * (0.92 + 0.1 * $lo(uv));\n}\nfloat rough_$name(vec2 uv) { return 0.86 + 0.08 * $fine(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house block",
    "name": "house block",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house block"
   },
   "type": "shader"
  },
