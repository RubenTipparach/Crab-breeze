  {
   "name": "shader_4",
   "node_position": {
    "x": 1100,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "chip",
      "longdesc": "chip",
      "name": "chip",
      "shortdesc": "chip",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nvec4 cell_$name(vec2 uv) {\n\tfloat row = floor(uv.y * 24.0);\n\tfloat x = uv.x * 8.0 + 0.5 * mod(row, 2.0);\n\treturn vec4(fract(x) * 0.225, fract(uv.y * 24.0) * 0.075, mod(floor(x), 8.0), mod(row, 24.0));\n}\n// Metres in from the brick's edge (negative in the joint), the arris broken by noise.\nfloat edge_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tfloat d = min(min(c.x, 0.225 - c.x), min(c.y, 0.075 - c.y)) - 0.005;\n\treturn d - 0.0028 * ($chip(uv) - 0.45);\n}\nfloat pit_$name(vec2 uv) { return smoothstep(0.72, 0.8, $fine(uv + vec2(0.5, 0.25))); }\nfloat height_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tfloat r = hs_$name(c.zw + 0.37);\n\tfloat d = edge_$name(uv);\n\tfloat face = 0.78 + 0.08 * (r - 0.5) + 0.06 * ($mid(uv) - 0.5) + 0.05 * ($fine(uv) - 0.5) - 0.12 * pit_$name(uv);\n\tfloat mortar = 0.18 + 0.1 * $fine(uv * 2.0);\n\treturn mix(mortar, face, smoothstep(-0.0006, 0.0028, d));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tfloat r = hs_$name(c.zw + 0.37);\n\tfloat v = mix(0.70, 0.88, r);\n\tif (hs_$name(c.zw + 5.1) > 0.92) { v *= 0.84; }\n\tif (hs_$name(c.zw + 9.3) < 0.12) { v = mix(v, 0.94, 0.5); }\n\tvec3 b = vec3(v, v * 0.975, v * 0.955);\n\tb *= 0.86 + 0.26 * $mid(uv) + 0.08 * ($fine(uv) - 0.5);\n\tb *= 1.0 - 0.45 * smoothstep(0.74, 0.82, $fine(uv * 2.0 + vec2(0.31, 0.77)));\n\tb = mix(b, b * 0.55, 0.6 * pit_$name(uv));\n\tvec3 mortar = vec3(0.90, 0.89, 0.86) * (0.86 + 0.2 * $fine(uv * 2.0));\n\tvec3 col = mix(mortar, b, smoothstep(-0.0004, 0.0016, edge_$name(uv)));\n\treturn col * (0.9 + 0.14 * $lo(uv));\n}\nfloat rough_$name(vec2 uv) { return mix(0.94, 0.84 + 0.08 * $mid(uv), smoothstep(-0.0004, 0.0016, edge_$name(uv))); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "city brick",
    "name": "city brick",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "city brick"
   },
   "type": "shader"
  },
