  {
   "name": "shader_4",
   "node_position": {
    "x": 1100,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "marb",
      "longdesc": "marb",
      "name": "marb",
      "shortdesc": "marb",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "scuff",
      "longdesc": "scuff",
      "name": "scuff",
      "shortdesc": "scuff",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nvec4 cell_$name(vec2 uv) { vec2 p = uv * 2.0; return vec4(fract(p) * 0.45, mod(floor(p), 2.0)); }\nfloat edge_$name(vec2 uv) { vec4 c = cell_$name(uv); return min(min(c.x, 0.45 - c.x), min(c.y, 0.45 - c.y)) - 0.0015; }\nfloat height_$name(vec2 uv) {\n\tfloat d = edge_$name(uv);\n\treturn mix(0.2 + 0.05 * $fine(uv), 0.85 + 0.01 * $fine(uv), smoothstep(0.0, 0.0025, d));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec4 c = cell_$name(uv);\n\tfloat white = 1.0 - mod(c.z + c.w, 2.0);\n\tfloat m = smoothstep(0.55, 0.75, $marb(uv + vec2(c.z * 0.37, c.w * 0.21)));\n\tvec3 w = vec3(0.9, 0.89, 0.86) * (1.0 - 0.07 * m) * (1.0 - 0.06 * smoothstep(0.6, 0.8, $scuff(uv)));\n\tvec3 b = vec3(0.12, 0.12, 0.13) * (1.0 + 0.6 * m);\n\tvec3 t = mix(b, w, white);\n\tvec3 grout = vec3(0.55, 0.54, 0.5) * (0.88 + 0.2 * $fine(uv));\n\treturn mix(grout, t, smoothstep(0.0, 0.001, edge_$name(uv)));\n}\nfloat rough_$name(vec2 uv) {\n\tfloat t = 0.18 + 0.15 * smoothstep(0.55, 0.8, $scuff(uv)) + 0.04 * $lo(uv);\n\treturn mix(0.88, t, smoothstep(0.0, 0.001, edge_$name(uv)));\n}\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house floor tile",
    "name": "house floor tile",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house floor tile"
   },
   "type": "shader"
  },
