   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "grain",
      "longdesc": "grain",
      "name": "grain",
      "shortdesc": "grain",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat ds_$name(vec2 uv) { float xs = fract(uv.x * 8.0) * 0.125; return min(xs, 0.125 - xs); }\nfloat height_$name(vec2 uv) {\n\tfloat d = ds_$name(uv);\n\treturn 0.2 + 0.65 * smoothstep(0.004, 0.012, d) + 0.04 * $grain(uv);\n}\nvec3 albedo_$name(vec2 uv) {\n\tfloat v = 0.86 + 0.03 * ($grain(uv) - 0.5) + 0.02 * ($fine(uv) - 0.5);\n\tv *= 0.93 + 0.09 * $lo(uv);\n\treturn vec3(v, v * 0.99, v * 0.97);\n}\nfloat rough_$name(vec2 uv) { return 0.58 + 0.06 * $grain(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house skirt",
    "name": "house skirt",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house skirt"
   },
   "type": "shader"
  },
