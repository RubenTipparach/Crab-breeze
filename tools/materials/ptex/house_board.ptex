  {
   "name": "shader_5",
   "node_position": {
    "x": 1320,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "grain",
      "longdesc": "grain",
      "name": "grain",
      "shortdesc": "grain",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "saw",
      "longdesc": "saw",
      "name": "saw",
      "shortdesc": "saw",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "streak",
      "longdesc": "streak",
      "name": "streak",
      "shortdesc": "streak",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat dist_$name(vec2 uv) { float xs = fract(uv.x * 3.0) / 3.0; return min(xs, 1.0 / 3.0 - xs); }\nfloat batten_$name(vec2 uv) { return smoothstep(0.034, 0.029, dist_$name(uv)); }\nfloat height_$name(vec2 uv) {\n\tfloat b = batten_$name(uv);\n\tfloat board = 0.12 + 0.05 * $grain(uv) + 0.03 * $saw(uv);\n\tfloat top = 0.92 + 0.03 * $grain(uv + vec2(0.5, 0.0)) - 0.08 * smoothstep(0.024, 0.032, dist_$name(uv));\n\treturn mix(board, top, b);\n}\nvec3 albedo_$name(vec2 uv) {\n\tfloat k = floor(uv.x * 3.0 + 0.5);\n\tvec3 c = vec3(0.83, 0.79, 0.735) * (0.95 + 0.07 * hs_$name(vec2(k, 1.0)));\n\tc *= 0.9 + 0.14 * $grain(uv) + 0.05 * ($saw(uv) - 0.5);\n\tc *= 1.0 - 0.08 * smoothstep(0.55, 0.8, $streak(uv));\n\tc *= 0.95 + 0.07 * $lo(uv);\n\treturn mix(c, c * 1.03, batten_$name(uv));\n}\nfloat rough_$name(vec2 uv) { return 0.74 + 0.1 * $saw(uv) - 0.04 * batten_$name(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house board",
    "name": "house board",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house board"
   },
   "type": "shader"
  },
