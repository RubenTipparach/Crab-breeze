  {
   "name": "shader_3",
   "node_position": {
    "x": 880,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "warp",
      "longdesc": "warp",
      "name": "warp",
      "shortdesc": "warp",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fibre",
      "longdesc": "fibre",
      "name": "fibre",
      "shortdesc": "fibre",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat k_$name(vec2 uv) { return mod(floor(uv.x * 6.0), 6.0); }\nfloat vd_$name(vec2 uv) { float xs = fract(uv.x * 6.0) / 6.0; return min(xs, 1.0 / 6.0 - xs); }\n// Distance to this board's knot, in metres (an ellipse, longer along the board).\nfloat knot_$name(vec2 uv) {\n\tfloat k = k_$name(uv);\n\tvec2 c = vec2((k + 0.3 + 0.4 * hs_$name(vec2(k, 4.0))) / 6.0, hs_$name(vec2(k, 5.0)));\n\tvec2 d = uv - c;\n\td.y = abs(fract(d.y + 0.5) - 0.5);\n\tfloat r = 0.008 + 0.012 * hs_$name(vec2(k, 6.0));\n\treturn length(d * vec2(1.0, 0.55)) / r;\n}\nfloat late_$name(vec2 uv) {\n\tfloat kn = knot_$name(uv);\n\tfloat swirl = 0.6 * exp(-kn * 0.35);\n\tfloat ring = fract(uv.x * 36.0 + 1.5 * $warp(uv) + 0.2 * $warp(uv * 4.0 + vec2(0.6)) + swirl * 3.0 + 4.0 * hs_$name(vec2(k_$name(uv), 1.0)));\n\treturn smoothstep(0.62, 0.86, ring) * (1.0 - smoothstep(0.9, 1.0, ring));\n}\nfloat height_$name(vec2 uv) {\n\tfloat v = smoothstep(0.0, 0.004, vd_$name(uv));\n\treturn 0.25 + 0.6 * v + 0.04 * late_$name(uv) + 0.03 * $fibre(uv) - 0.05 * (1.0 - smoothstep(0.8, 1.0, knot_$name(uv)));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec3 c = vec3(0.87, 0.765, 0.61) * (0.94 + 0.1 * hs_$name(vec2(k_$name(uv), 2.0)));\n\tc *= 1.0 - 0.17 * late_$name(uv);\n\tc *= 0.94 + 0.08 * $fibre(uv) + 0.05 * ($lo(uv) - 0.5);\n\tfloat kn = knot_$name(uv);\n\tc = mix(c, vec3(0.42, 0.25, 0.12), 1.0 - smoothstep(0.7, 1.15, kn));\n\tc = mix(c, vec3(0.62, 0.45, 0.28), 0.5 * (1.0 - smoothstep(1.0, 1.9, kn)) * smoothstep(0.7, 1.0, kn));\n\treturn mix(c * 0.55, c, smoothstep(0.0, 0.0035, vd_$name(uv)));\n}\nfloat rough_$name(vec2 uv) { return 0.52 + 0.08 * $fibre(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house pine",
    "name": "house pine",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house pine"
   },
   "type": "shader"
  },
