   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "trowel",
      "longdesc": "trowel",
      "name": "trowel",
      "shortdesc": "trowel",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "straw",
      "longdesc": "straw",
      "name": "straw",
      "shortdesc": "straw",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat course_$name(vec2 uv) {\n\tfloat row = floor(uv.y * 20.0);\n\tfloat x = uv.x * 5.0 + 0.5 * mod(row, 2.0);\n\tfloat d = min(min(fract(x) * 0.5, (1.0 - fract(x)) * 0.5), min(fract(uv.y * 20.0), 1.0 - fract(uv.y * 20.0)) * 0.125);\n\td += 0.02 * ($mid(uv) - 0.5);\n\t// Shows only where the plaster is thin.\n\treturn (1.0 - smoothstep(0.0, 0.018, d)) * smoothstep(0.45, 0.7, $lo(uv + vec2(0.4, 0.2)));\n}\nfloat height_$name(vec2 uv) {\n\treturn 0.45 + 0.22 * ($lo(uv) - 0.5) + 0.18 * ($mid(uv) - 0.5) + 0.12 * ($trowel(uv) - 0.5) + 0.06 * $fine(uv)\n\t\t- 0.14 * course_$name(uv) - 0.1 * smoothstep(0.76, 0.86, $fine(uv + vec2(0.5)));\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec3 c = vec3(0.86, 0.82, 0.76) * (0.9 + 0.14 * $mid(uv) + 0.06 * ($trowel(uv) - 0.5));\n\tc *= 1.0 - 0.06 * course_$name(uv);\n\tc = mix(c, vec3(0.93, 0.85, 0.62), 0.55 * smoothstep(0.7, 0.78, $straw(uv)));\n\tc *= 1.0 - 0.35 * smoothstep(0.76, 0.86, $fine(uv + vec2(0.5)));\n\treturn c * (0.94 + 0.08 * $lo(uv));\n}\nfloat rough_$name(vec2 uv) { return 0.93 + 0.05 * $fine(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house adobe",
    "name": "house adobe",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house adobe"
   },
