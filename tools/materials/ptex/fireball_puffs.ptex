   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "erode",
      "longdesc": "erode",
      "name": "erode",
      "shortdesc": "erode",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "billow",
      "longdesc": "billow",
      "name": "billow",
      "shortdesc": "billow",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "turb",
      "longdesc": "turb",
      "name": "turb",
      "shortdesc": "turb",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "soot",
      "longdesc": "soot",
      "name": "soot",
      "shortdesc": "soot",
      "type": "f"
     }
    ],
    "instance": "float h_$name(float x) { return fract(sin(x * 12.9898 + 0.731) * 43758.5453); }\n\nvec2 cell_$name(vec2 uv) { return floor(uv * 4.0); }\nvec2 local_$name(vec2 uv) { return fract(uv * 4.0); }\nfloat edge_$name(vec2 uv) { vec2 c = local_$name(uv) - vec2(0.5); return smoothstep(0.5, 0.43, max(abs(c.x), abs(c.y))); }\n\nfloat height_$name(vec2 uv) {\n\tvec2 cl = cell_$name(uv);\n\tvec2 c = local_$name(uv);\n\tfloat id = cl.x + cl.y * 4.0;\n\tfloat sum = 0.0;\n\tfor (int i = 0; i < 9; i++) {\n\t\tfloat fi = float(i);\n\t\tfloat a = h_$name(id * 17.0 + fi * 3.7) * 6.2831853;\n\t\tfloat rr = 0.17 * h_$name(id * 5.3 + fi * 1.9) * min(fi, 1.0);\n\t\tvec2 ctr = vec2(0.5) + vec2(cos(a), sin(a)) * rr;\n\t\tfloat rad = mix(0.16, 0.27, h_$name(id * 9.1 + fi * 4.3)) * (1.0 - 0.04 * fi);\n\t\tfloat d = length(c - ctr);\n\t\t// A smooth union of the spheres, so they flow into each other with no crease.\n\t\tsum += exp(10.0 * sqrt(max(rad * rad - d * d, 0.0)) / 0.27);\n\t}\n\tfloat h = max(log(sum / 9.0) / 10.0, 0.0);\n\t// Billows: smaller rolls on the big ones, so the shading folds.\n\treturn h + 0.22 * smoothstep(0.0, 0.25, h) * ($billow(uv) - 0.5);\n}\n\nvec3 lit_$name(vec2 uv, float e) {\n\tfloat hx = height_$name(uv + vec2(e, 0.0)) - height_$name(uv - vec2(e, 0.0));\n\tfloat hy = height_$name(uv + vec2(0.0, e)) - height_$name(uv - vec2(0.0, e));\n\tvec3 n = normalize(vec3(-hx, -hy, 2.0 * e * 6.0));\n\treturn n;\n}\n\nvec4 fire_$name(vec2 uv) {\n\tfloat h = height_$name(uv);\n\tvec3 n = lit_$name(uv, 0.0015);\n\t// a fold or the rim faces away from the eye: cooler there\n\tfloat fold = 1.0 - clamp(n.z, 0.0, 1.0);\n\tfloat heat = clamp(0.2 + 1.1 * smoothstep(0.03, 0.55, h) - 0.7 * fold + 0.8 * ($turb(uv) - 0.5), 0.0, 1.0);\n\tvec3 c = mix(vec3(0.30, 0.06, 0.02), vec3(1.0, 0.42, 0.08), smoothstep(0.0, 0.55, heat));\n\tc = mix(c, vec3(1.0, 0.93, 0.72), smoothstep(0.55, 1.0, heat));\n\tc *= mix(1.0, 0.3, smoothstep(0.58, 0.78, $soot(uv)) * (1.0 - heat));\n\tfloat a = smoothstep(0.0, 0.45, h - 0.3 * ($erode(uv) - 0.5) - 0.05) * edge_$name(uv);\n\treturn vec4(c, a);\n}\n",
    "longdesc": "fireball puffs",
    "name": "fireball puffs",
    "outputs": [
     {
      "longdesc": "out0",
      "rgba": "fire_$name($uv)",
      "shortdesc": "out0",
      "type": "rgba"
     },
     {
      "f": "fire_$name($uv).a",
      "longdesc": "out1",
      "shortdesc": "out1",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "fireball puffs"
   },
   "type": "shader"
  },
