   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "streak",
      "longdesc": "streak",
      "name": "streak",
      "shortdesc": "streak",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat ds_$name(vec2 uv) { float xs = fract(uv.x * 6.0) / 6.0; return min(xs, 1.0 / 6.0 - xs); }\nfloat height_$name(vec2 uv) { return 0.15 + 0.8 * smoothstep(0.017, 0.009, ds_$name(uv)) + 0.004 * $fine(uv); }\nvec3 albedo_$name(vec2 uv) {\n\tfloat v = 0.88 + 0.025 * ($mid(uv) - 0.5);\n\tv *= 1.0 - 0.06 * smoothstep(0.55, 0.8, $streak(uv));\n\tv *= 0.96 + 0.05 * $lo(uv);\n\treturn vec3(v, v * 0.997, v * 0.985);\n}\nfloat rough_$name(vec2 uv) { return 0.42 + 0.08 * $mid(uv) + 0.06 * smoothstep(0.5, 0.8, $streak(uv)); }\nfloat metal_$name(vec2 uv) { return 0.4; }\n",
    "longdesc": "house ribbed",
    "name": "house ribbed",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house ribbed"
   },
