  {
   "name": "shader_4",
   "node_position": {
    "x": 1100,
    "y": 0
   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "grain",
      "longdesc": "grain",
      "name": "grain",
      "shortdesc": "grain",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat joint_$name(vec2 uv) {\n\tfloat row = mod(floor(uv.y * 6.0), 6.0);\n\tfloat dj = abs(fract(uv.x - hs_$name(vec2(row, 3.0)) + 0.5) - 0.5);\n\treturn 1.0 - smoothstep(0.0006, 0.0014, dj);\n}\nfloat height_$name(vec2 uv) {\n\tfloat f = fract(uv.y * 6.0);\n\tfloat lap = 0.3 + 0.7 * (1.0 - f);\n\tfloat h = mix(0.3, lap, smoothstep(0.0, 0.018, f));\n\th += 0.02 * ($grain(uv) - 0.5) + 0.006 * $fine(uv);\n\treturn h - 0.25 * joint_$name(uv);\n}\nvec3 albedo_$name(vec2 uv) {\n\tfloat f = fract(uv.y * 6.0);\n\tfloat v = 0.85 + 0.035 * ($grain(uv) - 0.5) + 0.03 * ($mid(uv) - 0.5) + 0.02 * ($fine(uv) - 0.5);\n\tv *= 1.0 - 0.06 * smoothstep(0.75, 1.0, f) * $lo(uv);\n\tv *= 0.95 + 0.07 * $lo(uv);\n\tv = mix(v, 0.32, 0.8 * joint_$name(uv));\n\treturn vec3(v, v * 0.995, v * 0.975);\n}\nfloat rough_$name(vec2 uv) { return 0.6 + 0.1 * $mid(uv) + 0.05 * $grain(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house siding",
    "name": "house siding",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house siding"
   },
