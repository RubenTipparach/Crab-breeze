   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "n64",
      "longdesc": "n64",
      "name": "n64",
      "shortdesc": "n64",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "tuft",
      "longdesc": "tuft",
      "name": "tuft",
      "shortdesc": "tuft",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat height_$name(vec2 uv) { return 0.5 * $tuft(uv) + 0.35 * $fine(uv) + 0.15 * $n64(uv); }\nvec3 albedo_$name(vec2 uv) {\n\tfloat v = 0.78 * (0.84 + 0.16 * $tuft(uv) + 0.08 * $fine(uv)) * (0.95 + 0.08 * $lo(uv));\n\treturn vec3(v, v * 0.96, v * 0.92);\n}\nfloat rough_$name(vec2 uv) { return 0.95; }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house carpet",
    "name": "house carpet",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house carpet"
   },
