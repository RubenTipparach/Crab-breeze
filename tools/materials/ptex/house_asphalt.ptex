   },
   "parameters": {},
   "seed_int": 0,
   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "mid",
      "longdesc": "mid",
      "name": "mid",
      "shortdesc": "mid",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "st",
      "longdesc": "st",
      "name": "st",
      "shortdesc": "st",
      "type": "f"
     },
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "stc",
      "longdesc": "stc",
      "name": "stc",
      "shortdesc": "stc",
      "type": "rgb"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "fine",
      "longdesc": "fine",
      "name": "fine",
      "shortdesc": "fine",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "crack",
      "longdesc": "crack",
      "name": "crack",
      "shortdesc": "crack",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat stone_$name(vec2 uv) { return smoothstep(0.05, 0.22, $st(uv)) * step(0.45, $stc(uv).g); }\nfloat crack_$name(vec2 uv) {\n\tfloat w = 1.0 - smoothstep(0.0, 0.01, $crack(uv + 0.015 * vec2($mid(uv) - 0.5, $mid(uv + vec2(0.5)) - 0.5)));\n\treturn w * smoothstep(0.58, 0.7, $lo(uv + vec2(0.6, 0.2)));\n}\nfloat height_$name(vec2 uv) {\n\treturn 0.42 + 0.3 * sqrt(stone_$name(uv)) + 0.15 * ($fine(uv) - 0.5) - 0.35 * crack_$name(uv);\n}\nvec3 albedo_$name(vec2 uv) {\n\tvec3 bind = vec3(0.24, 0.24, 0.245) * (0.85 + 0.3 * $fine(uv));\n\tvec3 st = mix(vec3(0.42, 0.41, 0.4), vec3(0.6, 0.58, 0.55), $stc(uv).r);\n\tvec3 c = mix(bind, st, 0.8 * stone_$name(uv));\n\tc *= 0.9 + 0.16 * $lo(uv) + 0.06 * ($mid(uv) - 0.5);\n\treturn c * (1.0 - 0.55 * crack_$name(uv));\n}\nfloat rough_$name(vec2 uv) { return 0.93 - 0.08 * stone_$name(uv) + 0.04 * $fine(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house asphalt",
    "name": "house asphalt",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house asphalt"
   },
