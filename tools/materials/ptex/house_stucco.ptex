     },
     {
      "default": "0.0",
      "function": true,
      "label": "n64",
      "longdesc": "n64",
      "name": "n64",
      "shortdesc": "n64",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "sand",
      "longdesc": "sand",
      "name": "sand",
      "shortdesc": "sand",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "blob",
      "longdesc": "blob",
      "name": "blob",
      "shortdesc": "blob",
      "type": "f"
     },
     {
      "default": "vec3(0.0)",
      "function": true,
      "label": "blobc",
      "longdesc": "blobc",
      "name": "blobc",
      "shortdesc": "blobc",
      "type": "rgb"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "streak",
      "longdesc": "streak",
      "name": "streak",
      "shortdesc": "streak",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat knock_$name(vec2 uv) {\n\tfloat k = smoothstep(0.42 + 0.2 * $n64(uv), 0.3 + 0.2 * $n64(uv), $blob(uv)) * step(0.4, $blobc(uv).g);\n\treturn k;\n}\nfloat height_$name(vec2 uv) {\n\treturn 0.3 + 0.25 * $n64(uv) + 0.2 * $sand(uv) + 0.08 * $mid(uv) + 0.3 * knock_$name(uv);\n}\nvec3 albedo_$name(vec2 uv) {\n\tfloat v = 0.86 + 0.05 * ($mid(uv) - 0.5) + 0.04 * ($sand(uv) - 0.5) + 0.02 * knock_$name(uv);\n\tv *= 1.0 - 0.07 * smoothstep(0.5, 0.75, $streak(uv)) * $lo(uv);\n\treturn vec3(v, v * 0.99, v * 0.965);\n}\nfloat rough_$name(vec2 uv) { return 0.9 + 0.06 * $sand(uv) - 0.04 * knock_$name(uv); }\nfloat metal_$name(vec2 uv) { return 0.0; }\n",
    "longdesc": "house stucco",
    "name": "house stucco",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house stucco"
