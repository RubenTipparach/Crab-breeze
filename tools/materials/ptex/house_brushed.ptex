   "shader_model": {
    "code": "",
    "global": "",
    "inputs": [
     {
      "default": "0.0",
      "function": true,
      "label": "s1",
      "longdesc": "s1",
      "name": "s1",
      "shortdesc": "s1",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "s2",
      "longdesc": "s2",
      "name": "s2",
      "shortdesc": "s2",
      "type": "f"
     },
     {
      "default": "0.0",
      "function": true,
      "label": "lo",
      "longdesc": "lo",
      "name": "lo",
      "shortdesc": "lo",
      "type": "f"
     }
    ],
    "instance": "\nfloat hs_$name(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\nfloat sat_$name(float x) { return clamp(x, 0.0, 1.0); }\n\nfloat height_$name(vec2 uv) { return 0.5 + 0.3 * ($s1(uv) - 0.5) + 0.2 * ($s2(uv) - 0.5); }\nvec3 albedo_$name(vec2 uv) {\n\tfloat v = 0.8 + 0.05 * ($s1(uv) - 0.5) + 0.04 * ($s2(uv) - 0.5);\n\treturn vec3(v * 0.98, v * 0.99, v);\n}\nfloat rough_$name(vec2 uv) { return 0.26 + 0.08 * $s1(uv) + 0.1 * smoothstep(0.55, 0.8, $lo(uv)); }\nfloat metal_$name(vec2 uv) { return 1.0; }\n",
    "longdesc": "house brushed",
    "name": "house brushed",
    "outputs": [
     {
      "f": "sat_$name(height_$name($uv))",
      "longdesc": "out0",
      "shortdesc": "out0",
      "type": "f"
     },
     {
      "longdesc": "out1",
      "rgba": "vec4(clamp(albedo_$name($uv), vec3(0.0), vec3(1.0)), 1.0)",
      "shortdesc": "out1",
      "type": "rgba"
     },
     {
      "f": "sat_$name(rough_$name($uv))",
      "longdesc": "out2",
      "shortdesc": "out2",
      "type": "f"
     },
     {
      "f": "sat_$name(metal_$name($uv))",
      "longdesc": "out3",
      "shortdesc": "out3",
      "type": "f"
     }
    ],
    "parameters": [],
    "shortdesc": "house brushed"
   },
