// @title Crab Breeze: Main Theme
// @cycles 48
// @drumkit 25
// @space gm_lead_2_sawtooth 0.25
// @space gm_lead_5_charang 0.3
// @space gm_lead_1_square 0.3
// @space gm_pad_poly 0.35
// @space gm_fx_crystal 0.35
// @space gm_fx_sci_fi 0.4
//
// The title theme, electronic and futuristic (owner, 2026-10-25: "electronic,
// scifi futuristic please!"): the call sign pulsing on a pluck out of a held pad,
// the Breeze on a trance lead over a pumping pad and a striding analog bass, a
// breakdown on Main Street with a snare build, then the drop: the Breeze on
// supersaws over a reese bass, arpeggios and a 909, climbing into the lift and a
// D major ending. 128 BPM, 48 bars (90 s). Motifs: docs/design/music.md.

setcps(128/60/4)

// ── MOTIF LIBRARY ──────────────────────────────────────────────
// The spine: 16 bars in D minor. Pass A ends on A major (the pull home),
// pass B climbs Gm Bb C into D MAJOR: the lift, the score's signature.
const SPINE_ROOTS = note(`<
  d2 bb1 f2 c2 d2 bb1 g1 a1
  d2 bb1 f2 c2 g1 bb1 c2 d2
>`)
const SPINE_CHORDS = note(`<
  [d3,f3,a3] [bb2,d3,f3] [f3,a3,c4] [c3,e3,g3] [d3,f3,a3] [bb2,d3,f3] [g2,bb2,d3] [a2,c#3,e3]
  [d3,f3,a3] [bb2,d3,f3] [f3,a3,c4] [c3,e3,g3] [g2,bb2,d3] [bb2,d3,f3] [c3,e3,g3] [d3,f#3,a3]
>`)
// The stride: 3+3+2 eighths, the mech's gait (stomp, stomp, step-step).
const STRIDE = "x ~ ~ x ~ ~ x ~"
const STRIDE_DRUMS = s(`[bd ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ bd ~ ~ ~,
                        ~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~]`)
// THE BREEZE: the mech, the hero. Rides the stride rhythm over the spine;
// the last bar sings the F sharp of D major.
const BREEZE = note(`<
  [d4@3 a4@3 g4 a4] [bb4@3 a4@3 f4 g4] [a4@3 c5@3 bb4 a4] [g4@6 f4 e4]
  [d4@3 a4@3 g4 a4] [bb4@3 d5@3 c5 bb4] [d5@3 g5@3 f5 e5] [e5@6 c#5 a4]
  [d4@3 a4@3 g4 a4] [bb4@3 a4@3 f4 g4] [a4@3 c5@3 d5 e5] [f5@3 e5@3 d5 c5]
  [d5@3 bb4@3 c5 d5] [f5@3 d5@3 e5 f5] [g5@3 e5@3 f5 g5] [f#5@3 a5@5]
>`)
// CALL SIGN: "CB" in Morse (-.-. -...) on A and D, two bars of 16ths.
// The radio, the briefing, the systems waking; the lock-on tone's rhythm.
const CALLSIGN = note("[a5@3 ~ a5 ~ a5@3 ~ a5 ~@3 d5@3 ~ d5 ~ d5 ~ d5 ~@9]/2")
// MAIN STREET: the city and its people, a hymn in F major.
const MAINSTREET = note(`<
  [c5@3 a4 g4@2 f4@2] [d5@3 c5 bb4@4] [a4@3 g4 f4@2 d4@2] [e4@2 g4@2 c5@4]
  [c5@3 a4 g4@2 f4@2] [d5@3 f5 e5@2 d5@2] [c5@2 bb4@2 a4@2 g4@2] [f4@8]
>`)
const STREET_ROOTS = note("<f2 bb1 d2 c2 f2 bb1 [g1 c2] f2>")
const STREET_CHORDS = note(`<
  [f3,a3,c4] [bb2,d3,f3] [d3,f3,a3] [c3,e3,g3]
  [f3,a3,c4] [bb2,d3,f3] [[g2,bb2,d3] [c3,e3,g3]] [f3,a3,c4]
>`)
// SCUTTLE: the alien crabs. 16ths grouped 3+3+3+3+2+2 (legs, sideways),
// grinding D against E flat and the tritone A flat.
const SCUTTLE = note(`<
  [d2 eb2 d2 d2 eb2 d2 ab1 a1 ab1 d2 eb2 d2 f2 e2 eb2 d2]
  [d2 eb2 d2 d2 eb2 d2 ab1 a1 ab1 d2 eb2 d2 bb1 a1 ab1 g1]
>`)
const SCUTTLE_ACCENT = "1 .55 .55 1 .55 .55 1 .55 .55 1 .55 .55 1 .55 1 .55"
// CLAW: the tritone stab on the scuttle's accents.
const CLAW = note("[d4,ab4]").struct("x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ x ~")
// SIREN: the crabs' wail, a slow chromatic fall over four bars.
const SIREN = note("<a4 ab4 g4 f#4>")
// THE HATCH: boarding. Stacked fourths climbing a step per hatch stage
// (two bars each), arriving on D major as the pilot sits.
const HATCH = note(`<
  [d3 g3 c4 f4]!2 [e3 a3 d4 g4]!2 [f3 bb3 e4 a4]!2 [g3 c4 f4 bb4]!2
  [a3 d4 g4 c5] [d3 a3 d4 f#4]
>`)
const HATCH_CHORDS = note(`<
  [d3,g3,c4,f4]!2 [e3,a3,d4,g4]!2 [f3,bb3,e4,a4]!2 [g3,c4,f4,bb4]!2
  [a3,d4,g4,c5] [d3,f#3,a3,d4]
>`)
// FANFARE: mission accomplished. Bb, C, D major: the lift, with the
// Breeze's head turned major.
const FANFARE = note(`<
  [d5@3 f5@3 d5 f5] [e5@3 g5@3 e5 g5] [d5@3 a5@3 g5 a5] [f#5@8]
  [b5@3 a5@3 f#5 g5] [a5@8]
>`)
const FANFARE_ROOTS = note("<bb1 c2 d2 d2 g1 d2>")
const FANFARE_CHORDS = note(`<
  [bb3,d4,f4] [c4,e4,g4] [d4,f#4,a4] [d4,f#4,a4] [g3,b3,d4] [d4,f#4,a4]
>`)
// ── END MOTIF LIBRARY ──────────────────────────────────────────

// an echo written as notes (LMMS's delay effect renders silence headless)
const echo = (p, t = 3/16) => stack(p, p.late(t).gain(0.35), p.late(2 * t).gain(0.14))
// sixteenth arpeggio over a chord: low, mid, high, mid
const arp16 = (chords) => chords.arp("0 1 2 1 0 2 1 2 0 1 2 1 0 2 1 2")
const power = (roots) => roots.add(note("[12,19,24]"))

const build = s("<~!6 [sd*4] [sd*8 sd*8]>")

// intro: the call sign on an echoing pluck over a held D minor, a rising sweep;
// kept well under theme A so the drop lands (owner: "intro on main theme is a little loud")
const intro = stack(
  echo(CALLSIGN.s("gm_lead_1_square").gain(0.4), 3/8),
  note("[d3,a3,e4]").s("gm_pad_poly").gain(0.22),
  note("<d3@4>").s("gm_fx_sci_fi").gain(0.3),
  s("bd*4").gain(saw.slow(4).range(0.08, 0.3))
)

// theme A: the Breeze on a trance lead, the pad pumping on the off-beats
const themeA = stack(
  echo(BREEZE.s("gm_lead_5_charang").gain(0.95)),
  SPINE_CHORDS.struct("x*8").gain("0.22 0.55").s("gm_pad_poly"),
  arp16(SPINE_CHORDS.add(note(12))).s("gm_lead_1_square").gain(0.25),
  SPINE_ROOTS.add(note(12)).struct(STRIDE).s("gm_synth_bass_1").gain(0.7),
  STRIDE_DRUMS.gain(0.65), s("~ cp ~ cp").gain(0.5), s("hh*16").gain(0.2),
  s("<~!7 [~ ~ ~ ~ ~ ~ ~ ~ sd sd sd sd sd sd sd sd]>").gain(0.55)
)

// breakdown: Main Street on a bell over a DX electric piano, a snare build to the drop
const street = stack(
  echo(MAINSTREET.s("gm_fx_crystal").gain(0.9)),
  STREET_CHORDS.struct("x ~ x ~ x ~ x ~").s("gm_epiano2").gain(0.5),
  STREET_ROOTS.s("gm_synth_bass_1").gain(0.55),
  s("hh*8").gain(0.2),
  build.gain(saw.slow(8).range(0.2, 0.8)),
  note("<~!6 c4@2>").s("gm_fx_sci_fi").gain(0.55)
)

// the drop: the Breeze on supersaws (and an octave up), reese bass, stabs on the stride
const themeB = stack(
  echo(BREEZE.s("gm_lead_2_sawtooth").gain(1.0)),
  BREEZE.add(note(12)).s("gm_lead_5_charang").gain(0.5),
  SPINE_CHORDS.struct("x*8").gain("0.3 0.8").s("gm_pad_poly"),
  SPINE_CHORDS.add(note(12)).struct(STRIDE).s("gm_synth_brass_1").gain(0.55),
  arp16(SPINE_CHORDS.add(note(12))).s("gm_lead_1_square").gain(0.4),
  SPINE_ROOTS.add(note(12)).struct("~ x ~ x ~ x ~ x").s("gm_synth_bass_2").gain(0.85),
  s("bd*4").gain(0.9), s("~ cp ~ cp").gain(0.7), s("[~ oh]*4").gain(0.35), s("hh*16").gain(0.25),
  s("<cr ~!7 cr ~!7>").gain(0.7)
)

// ending: Bb, C, D major (the lift), the supersaw ringing on A
const ending = stack(
  echo(note("<[d5@3 f5@3 d5 f5] [e5@3 g5@3 e5 g5] [f#5@3 a5@5] a5>").s("gm_lead_2_sawtooth").gain(1.0)),
  note("<[bb3,d4,f4] [c4,e4,g4] [d4,f#4,a4,d5] [d4,f#4,a4,d5]>").s("gm_synth_strings_1").gain(0.6),
  note("<[bb3,d4,f4] [c4,e4,g4] [d4,f#4,a4] ~>").struct("x ~ ~ x ~ ~ x ~").s("gm_synth_brass_1").gain(0.6),
  note("<bb2 c3 d3 d3>").s("gm_synth_bass_2").gain(0.8),
  s("<[bd, cr] [bd, cr] [bd, cr] ~>").gain(0.85), s("<[~ cp]*2 [~ cp]*2 [sd*8] ~>").gain(0.6)
)

arrange([4, intro], [16, themeA], [8, street], [16, themeB], [4, ending])
