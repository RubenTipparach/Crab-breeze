// @title Crab Breeze: Sortie
// @cycles 64
// @reverb 0.35
// @mix gm_trumpet vol=190
// @mix gm_french_horn vol=90
// @mix gm_contrabass vol=105
// @mix gm_distortion_guitar vol=70
// @mix gm_overdriven_guitar vol=70
// @mix gm_choir_aahs vol=85
// @mix square vol=14
// @mix supersaw vol=30
//
// The fight: the mission music while the mech is in combat. Radio call sign
// over a racing D pedal, the Breeze on trumpets and a supersaw over chugging
// guitars, the crabs pushing in (scuttle, claw, siren) and the Breeze taking
// their rhythm back. 150 BPM, 64 bars (102 s); the last bar sits on A so the
// track loops straight back into the opening. Motifs: docs/design/music.md.

setcps(150/60/4)

// ── MOTIF LIBRARY ──────────────────────────────────────────────
// The spine: 16 bars in D minor. Pass A ends on A major (the pull home),
// pass B climbs Gm Bb C into D MAJOR: the lift, the score's signature.
const SPINE_ROOTS = note(`<
  d2 bb1 f2 c2 d2 bb1 g1 a1
  d2 bb1 f2 c2 g1 bb1 c2 d2
>`)
const SPINE_CHORDS = note(`<
  [d3,f3,a3] [bb2,d3,f3] [f3,a3,c4] [c3,e3,g3] [d3,f3,a3] [bb2,d3,f3] [g2,bb2,d3] [a2,c#3,e3]
  [d3,f3,a3] [bb2,d3,f3] [f3,a3,c4] [c3,e3,g3] [g2,bb2,d3] [bb2,d3,f3] [c3,e3,g3] [d3,f#3,a3]
>`)
// The stride: 3+3+2 eighths, the mech's gait (stomp, stomp, step-step).
const STRIDE = "x ~ ~ x ~ ~ x ~"
const STRIDE_DRUMS = s(`[bd ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ bd ~ ~ ~,
                        ~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~]`)
// THE BREEZE: the mech, the hero. Rides the stride rhythm over the spine;
// the last bar sings the F sharp of D major.
const BREEZE = note(`<
  [d4@3 a4@3 g4 a4] [bb4@3 a4@3 f4 g4] [a4@3 c5@3 bb4 a4] [g4@6 f4 e4]
  [d4@3 a4@3 g4 a4] [bb4@3 d5@3 c5 bb4] [d5@3 g5@3 f5 e5] [e5@6 c#5 a4]
  [d4@3 a4@3 g4 a4] [bb4@3 a4@3 f4 g4] [a4@3 c5@3 d5 e5] [f5@3 e5@3 d5 c5]
  [d5@3 bb4@3 c5 d5] [f5@3 d5@3 e5 f5] [g5@3 e5@3 f5 g5] [f#5@3 a5@5]
>`)
// CALL SIGN: "CB" in Morse (-.-. -...) on A and D, two bars of 16ths.
// The radio, the briefing, the systems waking; the lock-on tone's rhythm.
const CALLSIGN = note("[a5@3 ~ a5 ~ a5@3 ~ a5 ~@3 d5@3 ~ d5 ~ d5 ~ d5 ~@9]/2")
// MAIN STREET: the city and its people, a hymn in F major.
const MAINSTREET = note(`<
  [c5@3 a4 g4@2 f4@2] [d5@3 c5 bb4@4] [a4@3 g4 f4@2 d4@2] [e4@2 g4@2 c5@4]
  [c5@3 a4 g4@2 f4@2] [d5@3 f5 e5@2 d5@2] [c5@2 bb4@2 a4@2 g4@2] [f4@8]
>`)
const STREET_ROOTS = note("<f2 bb1 d2 c2 f2 bb1 [g1 c2] f2>")
const STREET_CHORDS = note(`<
  [f3,a3,c4] [bb2,d3,f3] [d3,f3,a3] [c3,e3,g3]
  [f3,a3,c4] [bb2,d3,f3] [[g2,bb2,d3] [c3,e3,g3]] [f3,a3,c4]
>`)
// SCUTTLE: the alien crabs. 16ths grouped 3+3+3+3+2+2 (legs, sideways),
// grinding D against E flat and the tritone A flat.
const SCUTTLE = note(`<
  [d2 eb2 d2 d2 eb2 d2 ab1 a1 ab1 d2 eb2 d2 f2 e2 eb2 d2]
  [d2 eb2 d2 d2 eb2 d2 ab1 a1 ab1 d2 eb2 d2 bb1 a1 ab1 g1]
>`)
const SCUTTLE_ACCENT = "1 .55 .55 1 .55 .55 1 .55 .55 1 .55 .55 1 .55 1 .55"
// CLAW: the tritone stab on the scuttle's accents.
const CLAW = note("[d4,ab4]").struct("x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ x ~")
// SIREN: the crabs' wail, a slow chromatic fall over four bars.
const SIREN = note("<a4 ab4 g4 f#4>")
// THE HATCH: boarding. Stacked fourths climbing a step per hatch stage
// (two bars each), arriving on D major as the pilot sits.
const HATCH = note(`<
  [d3 g3 c4 f4]!2 [e3 a3 d4 g4]!2 [f3 bb3 e4 a4]!2 [g3 c4 f4 bb4]!2
  [a3 d4 g4 c5] [d3 a3 d4 f#4]
>`)
const HATCH_CHORDS = note(`<
  [d3,g3,c4,f4]!2 [e3,a3,d4,g4]!2 [f3,bb3,e4,a4]!2 [g3,c4,f4,bb4]!2
  [a3,d4,g4,c5] [d3,f#3,a3,d4]
>`)
// FANFARE: mission accomplished. Bb, C, D major: the lift, with the
// Breeze's head turned major.
const FANFARE = note(`<
  [d5@3 f5@3 d5 f5] [e5@3 g5@3 e5 g5] [d5@3 a5@3 g5 a5] [f#5@8]
  [b5@3 a5@3 f#5 g5] [a5@8]
>`)
const FANFARE_ROOTS = note("<bb1 c2 d2 d2 g1 d2>")
const FANFARE_CHORDS = note(`<
  [bb3,d4,f4] [c4,e4,g4] [d4,f#4,a4] [d4,f#4,a4] [g3,b3,d4] [d4,f#4,a4]
>`)
// ── END MOTIF LIBRARY ──────────────────────────────────────────

const power = (roots) => roots.add(note("[12,19,24]"))
const fill = s("<~!7 [~ ~ ~ ~ ~ ~ ~ ~ sd sd ht ht mt mt ft ft]>")
const rock = stack(STRIDE_DRUMS, s("hh*8").gain(0.4), s("~ ~ ~ ~ ~ ~ ~ oh").gain(0.4))

// engage: the radio and a racing pedal on D, drums gathering
const engage = stack(
  CALLSIGN.s("square").gain(0.8),
  note("d3").struct("x*16").s("gm_tremolo_strings").gain(0.55),
  note("<d2!7 a1>").struct("x*8").s("gm_electric_bass_pick").gain(0.7),
  note("<[d2,a2]!7 [a1,e2]>").struct("x*8").s("gm_overdriven_guitar").gain(0.5),
  s("bd*4").gain(saw.slow(8).range(0.5, 1)),
  s("<~!6 [sd*4] [sd*8]>").gain(0.7)
)

// drive A: the Breeze on trumpets and a supersaw, guitars chugging
const driveA = stack(
  BREEZE.s("gm_trumpet").gain(1.05),
  BREEZE.s("supersaw").gain(0.6),
  power(SPINE_ROOTS).struct("x*8").s("gm_distortion_guitar").gain(0.6),
  SPINE_ROOTS.add(note(12)).struct("x*8").s("gm_electric_bass_pick").gain(0.85),
  SPINE_CHORDS.add(note(12)).struct(STRIDE).s("gm_brass_section").gain(0.6),
  SPINE_CHORDS.s("gm_string_ensemble_1").gain(0.45),
  rock.gain(0.95),
  s("<cr ~!7 cr ~!7>").gain(0.7),
  fill.gain(0.7)
)

// crabs: the scuttle in the low strings and guitars, claw stabs, the siren
// above; the second pass throws the Breeze's head against them on horns
const crabs = stack(
  SCUTTLE.add(note(12)).s("gm_cello").gain(SCUTTLE_ACCENT),
  SCUTTLE.add(note(12)).s("gm_overdriven_guitar").gain(SCUTTLE_ACCENT),
  SCUTTLE.s("gm_contrabass").gain(SCUTTLE_ACCENT),
  CLAW.s("gm_brass_section").gain(0.85),
  SIREN.add(note(12)).s("gm_choir_aahs").gain(0.65),
  SIREN.s("gm_tremolo_strings").gain(0.5),
  note("<~!8 [d4@3 a4@3 g4 a4] ~ [d4@3 a4@3 g4 a4] ~ [d4@3 a4@3 bb4 a4] ~ [d5@3 a4@3 g4 a4] [ab4@8]>")
    .s("gm_french_horn").gain(1.0),
  s("[bd ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ bd ~ bd ~, ~ ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~]").gain(0.9),
  s("<cr ~!7 cr ~!7>").gain(0.7),
  fill.gain(0.7)
)

// drive B: the Breeze an octave up, choir behind, the crab rhythm on the spine roots
const driveB = stack(
  BREEZE.add(note(12)).s("supersaw").gain(0.55),
  BREEZE.s("gm_trumpet").gain(1.05),
  BREEZE.sub(note(12)).s("gm_french_horn").gain(0.9),
  SPINE_CHORDS.add(note(12)).s("gm_choir_aahs").gain(0.6),
  power(SPINE_ROOTS).struct("x*16").s("gm_distortion_guitar").gain(SCUTTLE_ACCENT),
  SPINE_ROOTS.add(note(12)).struct("x*16").s("gm_electric_bass_pick").gain(SCUTTLE_ACCENT),
  SPINE_ROOTS.add(note(12)).struct(STRIDE).s("gm_timpani").gain(0.75),
  rock,
  s("<cr ~!7 cr ~!7>").gain(0.8),
  fill.gain(0.8)
)

// break: claw against call sign, sinking to A to loop home
const breakdown = stack(
  CALLSIGN.s("square").gain(0.8),
  CLAW.s("gm_brass_section").gain(0.7),
  note("<d2!6 bb1 a1>").struct("x*8").s("gm_electric_bass_pick").gain(0.75),
  note("<[d3,a3]!6 [bb2,f3] [a2,e3]>").struct(STRIDE).s("gm_distortion_guitar").gain(0.5),
  note("<[d3,f3,a3]!6 [bb2,d3,f3] [a2,c#3,e3]>").s("gm_string_ensemble_1").gain(0.55),
  s("bd*4, ~ sd ~ sd").gain(0.85),
  s("<~!7 [sd*8]>").gain(0.75)
)

arrange([8, engage], [16, driveA], [16, crabs], [16, driveB], [8, breakdown])
