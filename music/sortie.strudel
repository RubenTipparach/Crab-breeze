// @title Crab Breeze: Sortie
// @cycles 64
// @drumkit 25
// @layer bd Kicker/KickPower.xpf
// @layer cp Kicker/Clap.xpf
// @fx drums comp+drive
// @fx layer_bd comp
// @mix drums vol=200
// @mix layer_bd vol=120
// @mix layer_cp vol=150
// @fx master glue
// @space drums 0.08
// @mix gm_synth_bass_2 vol=7.5
// @mix gm_lead_2_sawtooth vol=72
// @space gm_lead_2_sawtooth 0.22
// @space gm_lead_5_charang 0.25
// @space gm_lead_1_square 0.25
// @space gm_pad_choir 0.35
//
// The fight: dark and aggressive on a 90s rave break. The radio call sign over a
// reese pedal and a 909 kick building; the rebel's riff on a gritty saw and acid
// over the chopped break; the crabs pushing in on a pounding 909 floor; then the
// hook on supersaws over the riff with the crab rhythm stolen into the bass.
// 150 BPM, 64 bars (102 s); loops. Motifs: docs/design/music.md.

setcps(150/60/4)

// ── MOTIF LIBRARY ──────────────────────────────────────────────
// The spine: 8 bars of dark D minor that never resolves. Dm(add9) twice, the
// flat-two E flat twice (the edge), B flat, C, then A sus4 sinking to A MINOR:
// no heroic major chord anywhere (owner, 2026-10-25: "too cheery and heroic. I
// want to feel like an edgy rebel").
const SPINE_ROOTS = note("<d2 d2 eb2 eb2 bb1 c2 a1 a1>")
const SPINE_CHORDS = note(`<
  [d3,f3,a3,e4] [d3,f3,a3,e4] [eb3,g3,bb3,d4] [eb3,g3,bb3,d4]
  [bb2,d3,f3,a3] [c3,g3,bb3,d4] [a2,d3,e3,a3] [a2,c3,e3,a3]
>`)
// The stride: 3+3+2 eighths, the mech's gait (stomp, stomp, step-step).
const STRIDE = "x ~ ~ x ~ ~ x ~"
const STRIDE_DRUMS = s(`[bd ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ bd ~ ~ ~,
                        ~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~]`)
// THE REBEL: the mech and its pilot. A low riff that snarls (two bars of
// sixteenths, D with the flat five A flat and the flat seven C) ...
const REBEL_RIFF = note(`<
  [d2 ~ d2 f2 ~ d2 g2 ~ ab2 ~ g2 f2 ~ d2 ~ ~]
  [d2 ~ d2 f2 ~ d2 c3 ~ bb2 ~ ab2 g2 f2 ~ d2 ~]
>`)
// ... and a hook over the spine, built as a sentence (docs/design/music.md, "Writing a
// melody"): a 2-bar idea (a syncopated figure, then a tail in the stride rhythm), the idea again a
// step up on the E flat chord, two bars that shorten it and climb, then the one high point (D6)
// and a falling tail that lands on an open A, leading straight back to bar 1.
const REBEL_HOOK = note(`<
  [a4@2 a4@3 c5@3 d5@4 c5@2 a4@2]   [g4@3 f4@3 e4@2 d4@8]
  [bb4@2 bb4@3 d5@3 eb5@4 d5@2 bb4@2] [ab4@3 g4@3 f4@2 eb4@8]
  [d5@2 d5@3 f5@3 g5@4 f5@2 d5@2]   [e5@2 e5@3 g5@3 bb5@4 a5@2 g5@2]
  [d6@6 c6@2 bb5@4 a5@4]            [a5@3 g5@3 e5@2 a4@8]
>`)
// CALL SIGN: "CB" in Morse (-.-. -...) on A and D, two bars of 16ths.
// The radio, the briefing, the systems waking; the lock-on tone's rhythm.
const CALLSIGN = note("[a5@3 ~ a5 ~ a5@3 ~ a5 ~@3 d5@3 ~ d5 ~ d5 ~ d5 ~@9]/2")
// SCUTTLE: the alien crabs. 16ths grouped 3+3+3+3+2+2 (legs, sideways),
// grinding D against E flat and the tritone A flat.
const SCUTTLE = note(`<
  [d2 eb2 d2 d2 eb2 d2 ab1 a1 ab1 d2 eb2 d2 f2 e2 eb2 d2]
  [d2 eb2 d2 d2 eb2 d2 ab1 a1 ab1 d2 eb2 d2 bb1 a1 ab1 g1]
>`)
const SCUTTLE_ACCENT = "1 .55 .55 1 .55 .55 1 .55 .55 1 .55 .55 1 .55 1 .55"
// CLAW: the tritone stab on the scuttle's accents.
const CLAW = note("[d4,ab4]").struct("x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ x ~")
// SIREN: the crabs' wail, a slow chromatic fall over four bars.
const SIREN = note("<a4 ab4 g4 f#4>")
// THE HATCH: boarding. Stacked fourths climbing a step per hatch stage
// (two bars each), landing on a dark D minor (add 9) as the pilot sits.
const HATCH = note(`<
  [d3 g3 c4 f4]!2 [e3 a3 d4 g4]!2 [f3 bb3 e4 a4]!2 [g3 c4 f4 bb4]!2
  [a3 d4 g4 c5] [d3 a3 e4 f4]
>`)
const HATCH_CHORDS = note(`<
  [d3,g3,c4,f4]!2 [e3,a3,d4,g4]!2 [f3,bb3,e4,a4]!2 [g3,c4,f4,bb4]!2
  [a3,d4,g4,c5] [d3,a3,e4,f4]
>`)
// GETAWAY: a mission done, no parade. The hook's figure on B flat and C, its stride tail on
// D minor, then D held: four grim, defiant bars.
const GETAWAY = note(`<
  [f5@2 f5@3 d5@3 bb4@4 d5@2 f5@2] [g5@2 g5@3 e5@3 c5@4 e5@2 g5@2]
  [a5@3 g5@3 f5@2 e5@8] [d5@16]
>`)
const GETAWAY_ROOTS = note("<bb1 c2 d2 d2>")
const GETAWAY_CHORDS = note("<[bb2,d3,f3,a3] [c3,g3,bb3,d4] [d3,f3,a3,e4] [d3,f3,a3,e4]>")
// ── END MOTIF LIBRARY ──────────────────────────────────────────

// an echo written as notes (LMMS's delay effect renders silence headless)
const echo = (p, t = 3/16) => stack(p, p.late(t).gain(0.35), p.late(2 * t).gain(0.14))
// sixteenth arpeggio over a chord
const arp16 = (chords) => chords.arp("0 1 2 3 2 1 0 2 0 1 2 3 2 1 3 2")
// rain on the city (the soundfont's FX rain, held a bar at a time)
const rain = note("c4").s("gm_fx_rain").gain(0.5)

// 90s drums (owner, 2026-10-25: "we need really strong percussion like edm from the 90s"): the
// soundfont's 909 kit with an LMMS Kicker kick under every bd and a Kicker clap under every cp
// (@layer), squashed and driven on the drum bus (@fx drums comp+drive), played hard.
// BIGBEAT: a big-beat break, Chemical Brothers style (90-110 BPM)
const BIGBEAT = stack(
  s("bd ~ ~ bd ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~").gain(1.2),
  s("~ ~ ~ ~ [sd, cp] ~ ~ ~ ~ ~ ~ ~ [sd, cp] ~ ~ ~").gain(1.15),
  s("~ ~ ~ ~ ~ ~ ~ sd ~ sd ~ ~ ~ ~ ~ sd").gain(0.4),
  s("hh*16").gain("[0.6 0.3 0.45 0.3]*4"),
  s("~ ~ oh ~ ~ ~ oh ~").gain(0.5),
  s("~ tb ~ tb").gain(0.35)
)
// FLOOR: a 909 four-on-the-floor, techno and trance style (125-145 BPM)
const FLOOR = stack(
  s("bd*4").gain(1.2),
  s("~ cp ~ cp").gain(1.05),
  s("[~ oh]*4").gain(0.6),
  s("hh*16").gain("[0.45 0.25 0.35 0.25]*4"),
  s("~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [sd sd]").gain(0.45)
)
// RAVE: a chopped rave break, Prodigy style (140-160 BPM)
const RAVE = stack(
  s("bd ~ bd ~ ~ ~ ~ ~ ~ ~ bd bd ~ ~ ~ ~").gain(1.2),
  s("~ ~ ~ ~ [sd, cp] ~ ~ sd ~ sd ~ ~ [sd, cp] ~ ~ sd").gain("1.15 1 1 1.15 0.6"),
  s("rd*8").gain(0.4),
  s("hh*16").gain("[0.5 0.25 0.4 0.25]*4")
)
const crash8 = s("<cr ~!7>").gain(0.8)
const crash4 = s("<cr ~!3>").gain(0.8)
const roll = s("<~!7 [~ ~ ~ ~ ~ ~ ~ ~ sd sd sd sd sd sd sd sd]>").gain(0.8)

// engage: the radio, a reese pedal on D, a 909 kick building to the break
const engage = stack(
  echo(CALLSIGN.s("gm_lead_1_square").gain(0.8), 3/8),
  note("<d2!7 eb2>").struct("x*8").s("gm_synth_bass_2").gain(0.75),
  note("<[d3,a3,e4]!7 [eb3,bb3,d4]>").s("gm_pad_choir").gain(0.4),
  s("bd*4").gain(saw.slow(8).range(0.6, 1.2)),
  s("hh*16").gain(saw.slow(8).range(0.1, 0.5)),
  s("<~!6 [sd*4] [sd*8 sd*16]>").gain(1.0)
)

// the riff over the rave break: gritty saw, acid an octave up, reese below
const riff = stack(
  REBEL_RIFF.add(note(12)).s("gm_lead_7_fifths").gain(0.8),
  REBEL_RIFF.add(note(24)).s("gm_lead_8_bass_lead").gain(0.45),
  REBEL_RIFF.s("gm_synth_bass_2").gain(0.8),
  arp16(SPINE_CHORDS.add(note(12))).s("gm_lead_1_square").gain(0.3),
  SPINE_CHORDS.s("gm_pad_choir").gain(0.35),
  RAVE, crash8, roll
)

// crabs on a 909 floor: the scuttle on acid and reese, claw stabs, the siren; the
// second pass throws the rebel's riff against them
const crabs = stack(
  SCUTTLE.add(note(12)).s("gm_lead_8_bass_lead").gain(SCUTTLE_ACCENT),
  SCUTTLE.s("gm_synth_bass_2").gain(SCUTTLE_ACCENT),
  CLAW.s("gm_synth_brass_1").gain(0.7),
  SIREN.add(note(12)).s("gm_pad_choir").gain(0.55),
  note("<~!8 [d3 ~ d3 f3 ~ d3 g3 ~ ab3 ~ g3 f3 ~ d3 ~ ~]!8>").s("gm_lead_7_fifths").gain(0.7),
  FLOOR, crash8, roll
)

// the hook on supersaws over the riff, the bass in the crab rhythm, the rave break
const hook = stack(
  echo(REBEL_HOOK.s("gm_lead_2_sawtooth").gain(1.0)),
  REBEL_HOOK.sub(note(12)).s("gm_lead_5_charang").gain(0.5),
  REBEL_RIFF.add(note(12)).s("gm_lead_7_fifths").gain(0.55),
  SPINE_ROOTS.add(note(12)).struct("x*16").s("gm_synth_bass_2").gain(SCUTTLE_ACCENT),
  SPINE_CHORDS.add(note(12)).struct(STRIDE).s("gm_synth_brass_1").gain(0.5),
  RAVE, crash8, roll
)

// break: the claw against the call sign, the riff alone on a 909 floor, back to the top
const breakdown = stack(
  echo(CALLSIGN.s("gm_lead_1_square").gain(0.8), 3/8),
  CLAW.s("gm_synth_brass_1").gain(0.55),
  REBEL_RIFF.s("gm_synth_bass_2").gain(0.75),
  note("<[d3,a3,e4]!6 [eb3,bb3,d4] [a2,c3,e3]>").s("gm_pad_choir").gain(0.45),
  s("bd*4").gain(1.15), s("~ cp ~ cp").gain(1.0), s("<~!7 [sd*8 sd*16]>").gain(1.0)
)

arrange([8, engage], [16, riff], [16, crabs], [16, hook], [8, breakdown])
